// 呼出中覆盖层: 显示被叫号码, 可取消
import { ButtonIntent, KitButton, KitMetrics, KitThemeContext, TypographyRole } from "@kit";

export component OutgoingCallOverlay inherits Rectangle {
    in property <string> peer;
    callback hangup();

    VerticalLayout {
        alignment: center;
        spacing: KitThemeContext.current.spacing.unit * 6;

        Text {
            text: @tr("呼叫 {} ...", root.peer);
            color: KitThemeContext.current.text-primary;
            font-family: KitThemeContext.current.typography.family;
            font-size: KitMetrics.font-size(KitThemeContext.current, TypographyRole.title);
            font-weight: KitThemeContext.current.typography.weight-semibold;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;

            KitButton {
                text: @tr("取消");
                intent: ButtonIntent.outline;
                activated => { root.hangup(); }
            }
        }
    }
}
