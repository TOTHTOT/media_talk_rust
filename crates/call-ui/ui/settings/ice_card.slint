// 设置页 ICE 通话卡: sigserver/房间/STUN 设置 + 呼叫/挂断 + 状态行.
import {
    ButtonIntent,
    KitCard,
    KitCardBody,
    KitCardHeader,
    KitMetrics,
    LayoutSpace,
    TypographyRole,
} from "@kit";
import { LucideIcons } from "@kit-icons/all.slint";
import { IconTextButton } from "../components/icon_text_button.slint";
import { KbTextField, KeyboardCtx } from "../kb_text_field.slint";

export component IceSettingsCard inherits KitCard {
    callback ice-call();
    callback ice-hangup();
    // 三个文本项写 kv (下次呼叫生效), 照 general_card 的 set-city 模式
    callback set-sigserver(string);
    callback set-room(string);
    callback set-stun(string);
    // 输入框 in-out: 初始值由 Rust 启动时从 kv 读入
    in-out property <string> sigserver: "";
    in-out property <string> room: "";
    in-out property <string> stun: "";
    // 状态行 + 统计行 (ice worker 投递, 文案后端直出不进 @tr)
    in property <string> status-text: "";
    in property <string> stats-text: "";
    // 聚焦字段在卡片内的 y 偏移 (相对卡片根), 设置页抬升门控用;
    // 由 KbTextField focus-changed 在聚焦时写入
    in-out property <length> focus-offset-y: 0px;
    // 聚焦通知: true = 某字段获得焦点 (携带卡片内偏移), false = 失焦
    callback kb-field-focused(bool);
    // 由 KbTextField focus-changed 在聚焦时写入

    // 呼叫进行中: 状态文案是 ice.rs post_status 的直出字面量, 这里按
    // 三个建立中/通话中的状态推导 (错误文案与空闲都回可呼叫)
    property <bool> calling: root.status-text == "收集中"
        || root.status-text == "连接中" || root.status-text == "已连接";

    inset: LayoutSpace.roomy;
    gap: LayoutSpace.regular;

    KitCardHeader {
        title: @tr("ICE 通话");
    }

    KitCardBody {
        // 信令服务器: 留空用默认 ws://127.0.0.1:9000. 输入即提交
        f1 := KbTextField {
            label: @tr("信令服务器");
            supporting-text: @tr("ws://Mac的局域网IP:9000");
            text <=> root.sigserver;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-sigserver(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f1.absolute-position.y - root.absolute-position.y; }
                root.kb-field-focused(focused);
            }
        }

        // 房间名: 两人填同一个
        f2 := KbTextField {
            label: @tr("房间名");
            supporting-text: @tr("两人填同一个房间名");
            text <=> root.room;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-room(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f2.absolute-position.y - root.absolute-position.y; }
                root.kb-field-focused(focused);
            }
        }

        // STUN URI: 显式留空 = 仅 host 候选 (局域网调试)
        f3 := KbTextField {
            label: "STUN";
            supporting-text: @tr("留空仅 host 候选");
            text <=> root.stun;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-stun(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f3.absolute-position.y - root.absolute-position.y; }
                root.kb-field-focused(focused);
            }
        }

        // 呼叫 / 挂断: 进行中禁用呼叫, 空闲禁用挂断
        HorizontalLayout {
            spacing: root.theme.spacing.unit * 3;
            alignment: start;
            IconTextButton {
                intent: ButtonIntent.success;
                icon: LucideIcons.phone-call();
                text: @tr("呼叫");
                disabled: root.calling;
                activated => { root.ice-call(); }
            }

            IconTextButton {
                intent: ButtonIntent.destructive;
                icon: LucideIcons.phone-off();
                text: @tr("挂断");
                disabled: !root.calling;
                activated => { root.ice-hangup(); }
            }
        }

        // 状态行: 状态文案 + 收发统计 (通话期每秒上报, 空闲隐藏统计)
        Text {
            text: root.status-text;
            color: root.theme.text-secondary;
            font-family: root.theme.typography.family;
            font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
            wrap: word-wrap;
        }

        if root.calling: Text {
            text: root.stats-text;
            color: root.theme.text-secondary;
            font-family: root.theme.typography.family;
            font-size: KitMetrics.font-size(root.theme, TypographyRole.caption);
            wrap: word-wrap;
        }
    }
}
