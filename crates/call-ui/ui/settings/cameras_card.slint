// 设置页摄像头管理卡: 已保存列表 (增删; 查看在监控页)
import {
    KitCard,
    KitCardBody,
    KitCardHeader,
    KitIconButton,
    KitMetrics,
    TypographyRole,
    KitButton,
} from "@kit";
import { LucideIcons } from "@kit-icons/all.slint";
import { CameraEntry } from "../components.slint";
import { IconTextButton } from "../components/icon_text_button.slint";

export component CamerasCard inherits KitCard {
    in property <[CameraEntry]> cameras: [];
    callback delete-camera(int);
    // 弹对话框由页面统一编排 (对话框覆盖层挂在页面根部)
    callback search-clicked();
    callback manual-clicked();

    // 对话框关闭后把焦点还给打开它的按钮
    public function focus-search() { search-button.take-focus(); }
    public function focus-manual() { manual-button.take-focus(); }

    KitCardHeader {
        title: @tr("摄像头");
    }

    KitCardBody {
        if root.cameras.length == 0: Text {
            text: @tr("暂无已保存的摄像头");
            color: root.theme.text-secondary;
            font-family: root.theme.typography.family;
            font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
        }

        for cam in root.cameras: HorizontalLayout {
            width: 100%;
            spacing: root.theme.spacing.unit * 3;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: root.theme.spacing.unit / 2;

                Text {
                    text: cam.name;
                    color: root.theme.text-primary;
                    font-family: root.theme.typography.family;
                    font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
                    font-weight: root.theme.typography.weight-medium;
                    overflow: elide;
                }

                Text {
                    text: cam.kind == "" ? cam.uri : cam.kind + " · " + cam.uri;
                    color: root.theme.text-secondary;
                    font-family: root.theme.typography.family;
                    font-size: KitMetrics.font-size(root.theme, TypographyRole.caption);
                    overflow: elide;
                }
            }

            KitIconButton {
                glyph: LucideIcons.trash();
                accessible-name: @tr("删除") + " " + cam.name;
                activated => { root.delete-camera(cam.id); }
            }
        }

        HorizontalLayout {
            spacing: root.theme.spacing.unit * 3;
            alignment: start;

            search-button := IconTextButton {
                icon: LucideIcons.search();
                text: @tr("搜索添加");
                activated => { root.search-clicked(); }
            }

            manual-button := IconTextButton {
                icon: LucideIcons.plus();
                text: @tr("手动添加");
                activated => { root.manual-clicked(); }
            }
        }
    }
}
