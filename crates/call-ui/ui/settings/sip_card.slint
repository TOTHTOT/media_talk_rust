// 设置页 SIP 通话卡: 服务器/账号/媒体源/限宽设置 + ICE 开关 + 高级 RTP 端口.
// 全部写 kv (下次呼叫生效), 照 ice_card 的 set-* 模式; 初值由 Rust 启动时
// 从 resolve 合成结果刷入.
import {
    FilledCard,
    HorizontalDivider,
    MaterialText,
    MaterialTypography,
    MaterialPalette,
    Switch,
} from "../../material-1.1.0/material.slint";
import { KbTextField, KeyboardCtx } from "../kb_text_field.slint";

export component SipSettingsCard inherits FilledCard {
    // 文本项写 kv (下次呼叫生效), 照 ice_card 的 set-* 模式
    callback set-server(string);
    callback set-username(string);
    callback set-password(string);
    callback set-expires(string);
    callback set-stun(string);
    callback set-local-ip(string);
    callback set-video-src(string);
    callback set-audio-src(string);
    callback set-max-width(string);
    callback set-rtp-audio(string);
    callback set-rtp-video(string);
    callback set-ice(bool);
    // 输入框 in-out: 初始值由 Rust 启动时从 resolve 合成结果刷入
    in-out property <string> server: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> expires: "";
    in-out property <string> stun: "";
    in-out property <string> local-ip: "";
    in-out property <string> video-src: "";
    in-out property <string> audio-src: "";
    // 视频限宽 (0 = 不限); 名不用 max-width: 与内建属性冲突
    in-out property <string> width-limit: "";
    in-out property <string> rtp-audio: "";
    in-out property <string> rtp-video: "";
    in-out property <bool> ice-enabled: false;
    // 密码明文开关 (眼睛图标), 仅 UI 态不落库
    in-out property <bool> show-password: false;
    // 聚焦字段在卡片内的 y 偏移 (相对卡片根), 设置页抬升门控用;
    // 由 KbTextField focus-changed 在聚焦时写入
    in-out property <length> focus-offset-y: 0px;
    // 聚焦通知: true = 某字段获得焦点 (携带卡片内偏移), false = 失焦
    callback kb-field-focused(bool);
    // 由 KbTextField focus-changed 在聚焦时写入

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        MaterialText {
            text: @tr("SIP 通话");
            style: MaterialTypography.headline_small;
        }

        HorizontalDivider {}

        // 服务器地址: ip:port
        f1 := KbTextField {
            label: @tr("服务器");
            supporting-text: @tr("ip:port");
            text <=> root.server;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-server(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f1.y; }
                root.kb-field-focused(focused);
            }
        }

        // SIP 账号
        f2 := KbTextField {
            label: @tr("账号");
            text <=> root.username;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-username(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f2.y; }
                root.kb-field-focused(focused);
            }
        }

        // 账号密码: 密码样式遮蔽
        f3 := KbTextField {
            label: @tr("密码");
            // 与根部属性同名, 枚举字面量需带 InputType 限定.
            // 尾部眼睛图标切换明文/掩码 (material TextField 内建 trailing 支持)
            input-type: root.show-password ? InputType.text : InputType.password;
            trailing-icon: root.show-password ? @image-url("../icons/eye-off.svg") : @image-url("../icons/eye.svg");
            trailing-icon-clicked => {
                root.show-password = !root.show-password;
            }
            text <=> root.password;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-password(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f3.y; }
                root.kb-field-focused(focused);
            }
        }

        // 注册有效期 (秒)
        f4 := KbTextField {
            label: @tr("注册有效期秒");
            supporting-text: @tr("秒");
            text <=> root.expires;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-expires(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f4.y; }
                root.kb-field-focused(focused);
            }
        }

        // STUN URI: 显式留空 = 仅 host 候选 (ICE 开启时生效)
        f5 := KbTextField {
            label: "STUN";
            supporting-text: @tr("留空仅 host 候选");
            text <=> root.stun;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-stun(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f5.y; }
                root.kb-field-focused(focused);
            }
        }

        // 本机 IP: 留空自动选择网卡 (多网卡/VPN 场景手动指定)
        f6 := KbTextField {
            label: @tr("本机IP");
            supporting-text: @tr("留空自动选择网卡");
            text <=> root.local-ip;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-local-ip(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f6.y; }
                root.kb-field-focused(focused);
            }
        }

        // 视频源: 相机 / 文件 / RTSP 网络相机
        f7 := KbTextField {
            label: @tr("视频源");
            supporting-text: @tr("camera[:设备] / file:路径 / rtsp://");
            text <=> root.video-src;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-video-src(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f7.y; }
                root.kb-field-focused(focused);
            }
        }

        // 音频源: 麦克风 / 文件
        f8 := KbTextField {
            label: @tr("音频源");
            supporting-text: @tr("mic / file:路径");
            text <=> root.audio-src;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-audio-src(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f8.y; }
                root.kb-field-focused(focused);
            }
        }

        // 视频限宽: 对端解码能力, 超宽源降采样; 0 = 不限
        f9 := KbTextField {
            label: @tr("限宽");
            supporting-text: @tr("0 = 不限");
            text <=> root.width-limit;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-max-width(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f9.y; }
                root.kb-field-focused(focused);
            }
        }

        // 高级: 被叫侧 RTP 首选端口 (主叫永远临时端口), 被占时回退临时端口
        MaterialText {
            text: @tr("高级");
            style: MaterialTypography.title_small;
            color: MaterialPalette.on_surface_variant;
        }

        f10 := KbTextField {
            label: @tr("音频RTP端口");
            text <=> root.rtp-audio;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-rtp-audio(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f10.y; }
                root.kb-field-focused(focused);
            }
        }

        f11 := KbTextField {
            label: @tr("视频RTP端口");
            text <=> root.rtp-video;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(text) => { root.set-rtp-video(text); }
            focus-changed(focused) => {
                if focused { root.focus-offset-y = f11.y; }
                root.kb-field-focused(focused);
            }
        }

        // ICE 开关: SIP offer/answer 附带 ICE 参数, 对端不回自动回退普通 RTP
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            MaterialText {
                text: @tr("启用 ICE");
                style: MaterialTypography.body_large;
                color: MaterialPalette.on_surface_variant;
                vertical-alignment: center;
            }

            Switch {
                checked <=> root.ice-enabled;
                checked_state_changed(checked) => { root.set-ice(checked); }
            }
        }
    }
}
