// 手动添加摄像头对话框内容, 可在 slint 预览器直接查看
import {
    ButtonIntent,
    KitButton,
    KitMetrics,
    KitThemeContext,
    TypographyRole,
} from "@kit";
import { KbTextField, KeyboardCtx } from "../kb_text_field.slint";

export component ManualCameraDialog inherits VerticalLayout {
    callback add-camera(string, string, string, string);
    callback cancelled();

    padding: KitThemeContext.current.spacing.unit * 6;
    spacing: KitThemeContext.current.spacing.unit * 3;

    Text {
        text: @tr("手动添加摄像头");
        color: KitThemeContext.current.text-primary;
        font-family: KitThemeContext.current.typography.family;
        font-size: KitMetrics.font-size(KitThemeContext.current, TypographyRole.subtitle);
        font-weight: KitThemeContext.current.typography.weight-semibold;
    }

    m-name := KbTextField {
        label: @tr("名称");
        commit-seq: KeyboardCtx.commit-seq;
        commit-text: KeyboardCtx.commit-text;
        delete-field: KeyboardCtx.delete-field;
    }

    m-uri := KbTextField {
        label: "RTSP URL";
        commit-seq: KeyboardCtx.commit-seq;
        commit-text: KeyboardCtx.commit-text;
        delete-field: KeyboardCtx.delete-field;
    }

    m-user := KbTextField {
        label: @tr("用户名");
        supporting-text: @tr("留空使用默认 admin");
        commit-seq: KeyboardCtx.commit-seq;
        commit-text: KeyboardCtx.commit-text;
        delete-field: KeyboardCtx.delete-field;
    }

    m-pass := KbTextField {
        label: @tr("密码");
        supporting-text: @tr("留空使用默认 123456");
        input-type: password;
        commit-seq: KeyboardCtx.commit-seq;
        commit-text: KeyboardCtx.commit-text;
        delete-field: KeyboardCtx.delete-field;
    }

    Rectangle { vertical-stretch: 1; }

    HorizontalLayout {
        spacing: KitThemeContext.current.spacing.unit * 3;
        alignment: end;
        KitButton {
            text: @tr("取消");
            intent: ButtonIntent.outline;
            activated => { root.cancelled(); }
        }

        KitButton {
            text: @tr("保存");
            disabled: m-name.text == "" || m-uri.text == "";
            activated => {
                root.add-camera(m-name.text, m-uri.text, m-user.text, m-pass.text);
            }
        }
    }
}
