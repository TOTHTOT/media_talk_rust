// ICE 手动通道 blob 对话框壳: 遮罩 + 导出/导入两种内容, 结构照 camera_dialogs.slint
// (本壳默认 mode=0 不可见, 不适合直接预览)
// 打开方式: 卡片调 open-export() / open-import() 公开函数
import {
    FilledCard,
    FilledButton,
    TextButton,
    MaterialText,
    MaterialTypography,
    MaterialPalette,
} from "../../material-1.1.0/material.slint";
import { TextEdit } from "std-widgets.slint";

export component IceDialogs inherits Rectangle {
    // 导出的本地 blob 文本 (Rust 侧 ice worker 导出后写进属性)
    in property <string> blob-text: "";
    callback import-apply(string);

    // 对话框: 0=无 1=导出 2=导入
    property <int> mode: 0;
    // 导入框草稿 (打开时清空, 应用时整体提交)
    property <string> import-draft: "";

    public function open-export() {
        root.mode = 1;
    }

    public function open-import() {
        root.import-draft = "";
        root.mode = 2;
    }

    // 隐藏时不占位不吃点击
    visible: mode != 0;

    // ===== 对话框遮罩 =====
    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;
        TouchArea {} // 吃掉点击, 不穿透到下层

        FilledCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 560px;
            height: 480px;

            // 导出: 本地 blob 只读展示, 复制给对端
            if root.mode == 1: VerticalLayout {
                padding: 24px;
                spacing: 12px;
                MaterialText {
                    text: @tr("本地 blob (复制给对端)");
                    style: MaterialTypography.title_large;
                }

                MaterialText {
                    text: @tr("先点呼叫, 状态变为收集中后即可导出");
                    style: MaterialTypography.body_small;
                    color: MaterialPalette.on_surface_variant;
                }

                TextEdit {
                    text: root.blob-text;
                    read-only: true;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;
                    TextButton {
                        text: @tr("关闭");
                        clicked => { root.mode = 0; }
                    }
                }
            }

            // 导入: 粘贴对端 blob, 应用后进入连通检查
            if root.mode == 2: VerticalLayout {
                padding: 24px;
                spacing: 12px;
                MaterialText {
                    text: @tr("导入对端 blob");
                    style: MaterialTypography.title_large;
                }

                TextEdit {
                    text <=> root.import-draft;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;
                    TextButton {
                        text: @tr("取消");
                        clicked => { root.mode = 0; }
                    }

                    FilledButton {
                        text: @tr("应用");
                        enabled: root.import-draft != "";
                        clicked => {
                            root.import-apply(root.import-draft);
                            root.mode = 0;
                        }
                    }
                }
            }
        }
    }
}
