// 设置页通用卡: 语言切换
import {
    FilledCard,
    TextButton,
    TextField,
    HorizontalDivider,
    MaterialText,
    MaterialTypography,
    MaterialPalette,
} from "../../material-1.1.0/material.slint";

export component GeneralSettingsCard inherits FilledCard {
    callback set-language(string); // "zh" | "en"
    // 天气城市: 回车/失焦提交, 留空 = IP 自动定位. in-out: 输入框
    // 可编辑, 初始值由 Rust 启动时从 kv 读入
    callback set-city(string);
    // 和风 API KEY (可选): 留空走 Open-Meteo. 密码样式遮蔽
    callback set-weather-key(string);
    in-out property <string> city: "";
    in-out property <string> weather-key: "";
    // 当前生效城市 (worker 定位结果), 输入框提示用
    in property <string> resolved-city: "";

    VerticalLayout {
        padding: 28px;
        spacing: 20px;
        MaterialText {
            text: @tr("设置");
            style: MaterialTypography.headline_small;
        }

        HorizontalDivider {}

        // 语言切换: 立即生效 (bundled translations), 重启后回系统 locale
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            MaterialText {
                text: @tr("语言");
                style: MaterialTypography.body_large;
                color: MaterialPalette.on_surface_variant;
                vertical-alignment: center;
            }

            TextButton {
                text: "中文";
                clicked => { root.set-language("zh"); }
            }

            TextButton {
                text: "English";
                clicked => { root.set-language("en"); }
            }
        }

        HorizontalDivider {}

        // 天气城市: 留空走 IP 自动定位. material TextField 的
        // placeholder_text 不渲染 (只进 accessibility), 提示走 supporting-text;
        // 定位成功后提示当前生效城市. edited 每次输入即提交 (不依赖回车),
        // 退出设置页时输入框的值必然已生效
        TextField {
            label: @tr("城市");
            supporting-text: root.resolved-city == ""
                ? @tr("留空自动定位")
                : @tr("当前: {}", root.resolved-city);
            text <=> root.city;
            edited(city) => { root.set-city(city); }
        }

        // 和风 key: 密码样式遮蔽, 留空回退免 key 的 Open-Meteo. 同上, 输入即提交
        TextField {
            label: @tr("和风 Key");
            supporting-text: @tr("留空使用 Open-Meteo");
            input-type: password;
            text <=> root.weather-key;
            edited(key) => { root.set-weather-key(key); }
        }
    }
}
