// 设置页通用卡: 语言、亮度、休眠时间、天气.
// 视觉统一走 Slint Kit; 文本字段是唯一例外, 继续用 KbTextField 接屏幕键盘.
import {
    KitButton,
    KitCard,
    KitCardBody,
    KitDivider,
    KitFieldLabel,
    KitMetrics,
    KitSelect,
    KitSlider,
    KitThemeContext,
    OptionRow,
    Ownership,
    SelectionRef,
    TypographyRole,
} from "@kit";
import { KbTextField, KeyboardCtx } from "../kb_text_field.slint";

export component GeneralSettingsCard inherits KitCard {
    callback set-language(string); // "zh" | "en"
    // 天气城市: 回车/失焦提交, 留空 = IP 自动定位. in-out: 输入框
    // 可编辑, 初始值由 Rust 启动时从 kv 读入
    callback set-city(string);
    // 和风 API KEY (可选): 留空走 Open-Meteo. 密码样式遮蔽
    callback set-weather-key(string);
    in-out property <string> city: "";
    in-out property <string> weather-key: "";
    // 当前生效城市 (worker 定位结果), 输入框提示用
    in property <string> resolved-city: "";
    // 屏幕亮度: 单位百分比. 所有平台都显示滑块, 不支持时由 Rust 侧
    // 在松手回调里弹 toast (滑块本身仍可拖动)
    in-out property <float> brightness: 80;
    // 自动休眠: 选项下标 (0=永不 1=15s 2=30s 3=60s 4=120s 5=300s),
    // 秒值映射只在 Rust 一处. 闲置超时自动熄屏, 任意输入/触摸唤醒
    // (熄屏遮罩点击). in-out: 初值由 Rust 从 kv 换算写入
    in-out property <int> sleep-timeout-index: 2;
    callback set-sleep-timeout-index(int);
    // 聚焦字段在卡片内的 y 偏移 (相对卡片根), 设置页抬升门控用;
    // 由 KbTextField focus-changed 在聚焦时写入
    in-out property <length> focus-offset-y: 0px;
    // 聚焦通知: true = 某字段获得焦点 (携带卡片内偏移), false = 失焦
    callback kb-field-focused(bool);
    // 由 KbTextField focus-changed 在聚焦时写入
    callback set-brightness(float);

    // KitSelect 用 token 保留现有下标语义, Rust 侧秒值映射不变.
    property <[OptionRow]> sleep-options: [
        { token: 0, generation: 1, label: @tr("永不"), description: "", disabled: false },
        { token: 1, generation: 1, label: "15", description: "", disabled: false },
        { token: 2, generation: 1, label: "30", description: "", disabled: false },
        { token: 3, generation: 1, label: "60", description: "", disabled: false },
        { token: 4, generation: 1, label: "120", description: "", disabled: false },
        { token: 5, generation: 1, label: "300", description: "", disabled: false },
    ];
    property <SelectionRef> sleep-selected: {
        present: root.sleep-timeout-index >= 0,
        token: root.sleep-timeout-index,
    };
    // 拖动中的显示值 (string 是 KitSlider 的公开 value 类型);
    // brightness 只在松手 chosen 时提交, 保持原硬件写入节奏.
    property <string> brightness-text: round(root.brightness) + "";
    changed brightness => {
        root.brightness-text = round(root.brightness) + "";
    }

    KitCardBody {
        // 语言切换: 立即生效 (bundled translations), 重启后回系统 locale
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                KitFieldLabel { text: @tr("语言"); }
            }

            KitButton {
                text: "中文";
                activated => { root.set-language("zh"); }
            }

            KitButton {
                text: "English";
                activated => { root.set-language("en"); }
            }
        }

        KitDivider { }

        // 屏幕亮度: 所有平台都显示且可拖动; 不支持时松手由 Rust 侧弹 toast.
        // 拖动只更新 UI, 松手才写 sysfs 并持久化, 避免拖动期间高频写背光.
        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                alignment: center;
                KitFieldLabel { text: @tr("屏幕亮度"); }
            }

            KitSlider {
                horizontal-stretch: 1;
                min-width: 120px;
                label: @tr("屏幕亮度");
                spec: { minimum: "5", maximum: "100", step: "1" };
                value <=> root.brightness-text;
                chosen(v) => { root.set-brightness(v.to-float()); }
            }

            Text {
                width: 48px;
                text: root.brightness-text + "%";
                color: KitThemeContext.current.text-secondary;
                font-family: KitThemeContext.current.typography.family;
                font-size: KitMetrics.font-size(KitThemeContext.current, TypographyRole.body);
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        KitDivider { }

        HorizontalLayout {
            spacing: 16px;

            VerticalLayout {
                alignment: center;
                KitFieldLabel { text: @tr("休眠时间: 秒"); }
            }

            KitSelect {
                horizontal-stretch: 1;
                max-width: 320px;
                label: @tr("休眠时间");
                options: root.sleep-options;
                selected: root.sleep-selected;
                selected-label: root.sleep-timeout-index >= 0
                    && root.sleep-timeout-index < root.sleep-options.length
                    ? root.sleep-options[root.sleep-timeout-index].label
                    : "";
                ownership: Ownership.controlled;
                searchable: false;
                chosen(row) => {
                    root.set-sleep-timeout-index(row.token);
                }
            }
        }

        KitDivider { }

        // 天气城市: 留空走 IP 自动定位. 输入即提交 (不依赖回车),
        // 退出设置页时输入框的值必然已生效. 聚焦弹屏幕键盘 (KbTextField)
        f1 := KbTextField {
            label: @tr("城市");
            supporting-text: root.resolved-city == ""
                ? @tr("留空自动定位")
                : @tr("当前: {}", root.resolved-city);
            text <=> root.city;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(city) => { root.set-city(city); }
            focus-changed(focused) => {
                if focused {
                    root.focus-offset-y = f1.absolute-position.y - root.absolute-position.y;
                }
                root.kb-field-focused(focused);
            }
        }

        // 和风 key: 密码样式遮蔽, 留空回退免 key 的 Open-Meteo. 同上, 输入即提交
        f2 := KbTextField {
            label: @tr("和风 Key");
            supporting-text: @tr("留空使用 Open-Meteo");
            input-type: password;
            text <=> root.weather-key;
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            edited(key) => { root.set-weather-key(key); }
            focus-changed(focused) => {
                if focused {
                    root.focus-offset-y = f2.absolute-position.y - root.absolute-position.y;
                }
                root.kb-field-focused(focused);
            }
        }
    }
}
