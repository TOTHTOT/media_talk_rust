// 拨号页左侧通讯录卡: 添加/编辑表单 + 联系人列表 (数据落 SQLite, 回调透传 Rust)
// 卡片用 Kit 主题令牌; 列表行用 KitPressable/KitAvatar/KitIconButton.
import {
    AvatarSize,
    ButtonIntent,
    ControlWidth,
    KitAvatar,
    KitButton,
    KitDivider,
    KitIconButton,
    KitMetrics,
    KitPressable,
    KitScrollArea,
    KitTheme,
    KitThemeContext,
    Tone,
    TypographyRole,
} from "@kit";
import { LucideIcons } from "@kit-icons/all.slint";
import { ContactEntry } from "../components.slint";
import { KbTextField, KeyboardCtx } from "../kb_text_field.slint";

export component ContactsCard inherits Rectangle {
    property <KitTheme> theme: KitThemeContext.current;
    in property <[ContactEntry]> contacts: [];
    callback add-contact(string, string); // name, number
    callback update-contact(int, string, string); // id, name, number
    callback delete-contact(int); // id
    callback pick-number(string); // 点列表行, 把号码交给拨号盘
    callback dial(string); // 行内电话图标快捷拨打

    background: root.theme.surface;
    border-width: root.theme.shape.border-width;
    border-color: root.theme.border-subtle;
    border-radius: root.theme.shape.radius-container;

    // 编辑态: -1=新增, 否则为正在编辑的联系人 id
    property <int> editing-id: -1;
    function clear-form() {
        name-input.text = "";
        number-input.text = "";
        root.editing-id = -1;
    }

    VerticalLayout {
        padding: root.theme.spacing.unit * 5;
        spacing: root.theme.spacing.unit * 3;

        Text {
            vertical-stretch: 0;
            text: @tr("通讯录");
            color: root.theme.text-primary;
            font-family: root.theme.typography.family;
            font-size: KitMetrics.font-size(root.theme, TypographyRole.subtitle);
            font-weight: root.theme.typography.weight-semibold;
        }

        // 添加/编辑表单 (编辑时点列表行的铅笔载入). KbTextField 聚焦弹屏幕键盘
        name-input := KbTextField {
            vertical-stretch: 0;
            label: @tr("姓名");
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
        }

        number-input := KbTextField {
            vertical-stretch: 0;
            label: @tr("号码");
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: root.theme.spacing.unit * 2;
            alignment: start;
            KitButton {
                text: root.editing-id < 0 ? @tr("添加") : @tr("保存");
                intent: ButtonIntent.primary;
                disabled: name-input.text == "" || number-input.text == "";
                activated => {
                    if (root.editing-id < 0) {
                        root.add-contact(name-input.text, number-input.text);
                    } else {
                        root.update-contact(root.editing-id, name-input.text, number-input.text);
                    }
                    root.clear-form();
                }
            }

            if root.editing-id >= 0: KitButton {
                text: @tr("取消");
                intent: ButtonIntent.outline;
                activated => { root.clear-form(); }
            }
        }

        KitDivider {
            vertical-stretch: 0;
        }

        if root.contacts.length == 0: Text {
            vertical-stretch: 1;
            text: @tr("暂无联系人");
            color: root.theme.text-secondary;
            font-family: root.theme.typography.family;
            font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.contacts.length > 0: KitScrollArea {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: root.theme.spacing.unit;

                for c in root.contacts: KitPressable {
                    width: 100%;
                    intent: ButtonIntent.quiet;
                    control-width: ControlWidth.fill;
                    accessible-name: c.name + " " + c.number;
                    activated => { root.pick-number(c.number); }

                    HorizontalLayout {
                        spacing: root.theme.spacing.unit * 2;

                        KitAvatar {
                            avatar-size: AvatarSize.compact;
                            initials: "";
                            fallback-icon: LucideIcons.user();
                            tone: Tone.accent;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: root.theme.spacing.unit / 2;

                            Text {
                                text: c.name;
                                color: root.theme.text-primary;
                                font-family: root.theme.typography.family;
                                font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
                                overflow: elide;
                            }

                            Text {
                                text: c.number;
                                color: root.theme.text-secondary;
                                font-family: root.theme.typography.family;
                                font-size: KitMetrics.font-size(root.theme, TypographyRole.caption);
                                overflow: elide;
                            }
                        }

                        KitIconButton {
                            glyph: LucideIcons.phone();
                            accessible-name: @tr("拨打") + " " + c.name;
                            activated => { root.dial(c.number); }
                        }

                        KitIconButton {
                            glyph: LucideIcons.pencil();
                            accessible-name: @tr("编辑") + " " + c.name;
                            activated => {
                                root.editing-id = c.id;
                                name-input.text = c.name;
                                number-input.text = c.number;
                            }
                        }

                        KitIconButton {
                            glyph: LucideIcons.trash();
                            accessible-name: @tr("删除") + " " + c.name;
                            activated => { root.delete-contact(c.id); }
                        }
                    }
                }
            }
        }
    }
}
