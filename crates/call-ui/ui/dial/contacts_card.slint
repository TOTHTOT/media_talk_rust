// 拨号页左侧通讯录卡: 添加/编辑表单 + 联系人列表 (数据落 SQLite, 回调透传 Rust)
import {
    TextButton,
    FilledButton,
    FilledCard,
    IconButton,
    ListTile,
    HorizontalDivider,
    MaterialText,
    MaterialTypography,
    MaterialPalette,
} from "../../material-1.1.0/material.slint";
import { ScrollView } from "std-widgets.slint";
import { ContactEntry } from "../components.slint";
import { KbTextField, KeyboardCtx } from "../kb_text_field.slint";

export component ContactsCard inherits FilledCard {
    in property <[ContactEntry]> contacts: [];
    callback add-contact(string, string); // name, number
    callback update-contact(int, string, string); // id, name, number
    callback delete-contact(int); // id
    callback pick-number(string); // 点列表行, 把号码交给拨号盘
    callback dial(string); // 行内电话图标快捷拨打
    // 屏幕键盘聚焦登记: 由 KbTextField focus-changed 转发, 逐层透传根部
    // root.kb-field-focused (Rust KeyboardController::set_focus)
    callback kb-field-focused(int);

    // 编辑态: -1=新增, 否则为正在编辑的联系人 id
    property <int> editing-id: -1;
    function clear-form() {
        name-input.text = "";
        number-input.text = "";
        root.editing-id = -1;
    }

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        // 表单区各行 vertical-stretch: 0 钉死内容高度, 弹性空间只给列表区,
        // 否则卡片拉高时输入框会被分摊撑高、间距变大
        MaterialText {
            vertical-stretch: 0;
            text: @tr("通讯录");
            style: MaterialTypography.title_large;
        }

        // 添加/编辑表单 (编辑时点列表行的铅笔载入). KbTextField 聚焦弹屏幕键盘
        name-input := KbTextField {
            vertical-stretch: 0;
            // field-id 对应 Rust 侧 keyboard::FIELD_CONTACT_NAME
            field-id: 3;
            label: @tr("姓名");
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            focus-changed(id) => {
                KeyboardCtx.visible = id >= 0;
                root.kb-field-focused(id);
            }
        }

        number-input := KbTextField {
            vertical-stretch: 0;
            // field-id 对应 Rust 侧 keyboard::FIELD_CONTACT_NUMBER
            field-id: 4;
            label: @tr("号码");
            commit-seq: KeyboardCtx.commit-seq;
            commit-text: KeyboardCtx.commit-text;
            delete-field: KeyboardCtx.delete-field;
            focus-changed(id) => {
                KeyboardCtx.visible = id >= 0;
                root.kb-field-focused(id);
            }
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 8px;
            alignment: start;
            FilledButton {
                text: root.editing-id < 0 ? @tr("添加") : @tr("保存");
                enabled: name-input.text != "" && number-input.text != "";
                clicked => {
                    if (root.editing-id < 0) {
                        root.add-contact(name-input.text, number-input.text);
                    } else {
                        root.update-contact(root.editing-id, name-input.text, number-input.text);
                    }
                    root.clear-form();
                }
            }

            if root.editing-id >= 0: TextButton {
                text: @tr("取消");
                clicked => { root.clear-form(); }
            }
        }

        HorizontalDivider {
            vertical-stretch: 0;
        }

        if root.contacts.length == 0: MaterialText {
            vertical-stretch: 1;
            text: @tr("暂无联系人");
            style: MaterialTypography.body_medium;
            color: MaterialPalette.outline;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.contacts.length > 0: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 2px;
                for c in root.contacts: ListTile {
                    width: 100%;
                    // 必须显式定高: ListTile 内部 min_height 与头像盒互为依赖, 不定死成环 panic
                    height: 72px;
                    text: c.name;
                    supporting_text: c.number;
                    clicked => { root.pick-number(c.number); }
                    // 快捷拨打/编辑/删除: inline 小号按钮 (18px), 标准 40px 三个太挤
                    IconButton {
                        inline: true;
                        icon: @image-url("../icons/phone.svg");
                        clicked => { root.dial(c.number); }
                    }

                    IconButton {
                        inline: true;
                        icon: @image-url("../icons/pencil.svg");
                        clicked => {
                            root.editing-id = c.id;
                            name-input.text = c.name;
                            number-input.text = c.number;
                        }
                    }

                    IconButton {
                        inline: true;
                        icon: @image-url("../icons/trash-2.svg");
                        clicked => { root.delete-contact(c.id); }
                    }
                }
            }
        }
    }
}
