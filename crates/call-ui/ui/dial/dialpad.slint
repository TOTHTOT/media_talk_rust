// 拨号盘: 号码输入 + 3x4 键盘 + 清除/拨打
// 按钮不写死尺寸, 用 stretch 随可用空间放大 (触屏好按)
import {
    TextField,
    TonalButton,
    OutlineButton,
    FilledButton,
} from "../../material-1.1.0/material.slint";

export component Dialpad inherits Rectangle {
    // 号码双向透出: 通讯录点行填号走这里
    in-out property <string> number-text <=> number.text;
    callback dial(string);

    VerticalLayout {
        spacing: 16px;
        number := TextField {
            vertical-stretch: 0;
            placeholder-text: @tr("输入号码");
        }

        HorizontalLayout {
            spacing: 12px;
            TonalButton {
                horizontal-stretch: 1;
                text: "1";
                clicked => { number.text += "1"; }
            }

            TonalButton {
                horizontal-stretch: 1;
                text: "2";
                clicked => { number.text += "2"; }
            }

            TonalButton {
                horizontal-stretch: 1;
                text: "3";
                clicked => { number.text += "3"; }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            TonalButton {
                horizontal-stretch: 1;
                text: "4";
                clicked => { number.text += "4"; }
            }

            TonalButton {
                horizontal-stretch: 1;
                text: "5";
                clicked => { number.text += "5"; }
            }

            TonalButton {
                horizontal-stretch: 1;
                text: "6";
                clicked => { number.text += "6"; }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            TonalButton {
                horizontal-stretch: 1;
                text: "7";
                clicked => { number.text += "7"; }
            }

            TonalButton {
                horizontal-stretch: 1;
                text: "8";
                clicked => { number.text += "8"; }
            }

            TonalButton {
                horizontal-stretch: 1;
                text: "9";
                clicked => { number.text += "9"; }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            TonalButton {
                horizontal-stretch: 1;
                text: "*";
                clicked => { number.text += "*"; }
            }

            TonalButton {
                horizontal-stretch: 1;
                text: "0";
                clicked => { number.text += "0"; }
            }

            TonalButton {
                horizontal-stretch: 1;
                text: "#";
                clicked => { number.text += "#"; }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            OutlineButton {
                horizontal-stretch: 1;
                text: @tr("清除");
                clicked => { number.text = ""; }
            }

            FilledButton {
                horizontal-stretch: 1;
                text: @tr("拨打");
                enabled: number.text != "";
                clicked => { root.dial(number.text); }
            }
        }
    }
}
