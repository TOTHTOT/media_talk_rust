// 设置页 (只读配置信息)
import {
    FilledCard,
    TextButton,
    MaterialText,
    MaterialTypography,
    MaterialPalette,
} from "../material-1.1.0/material.slint";

export component SettingsPage inherits Rectangle {
    in property <string> settings-text;
    callback back();
    callback set-language(string); // "zh" | "en"

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            alignment: start;
            TextButton {
                icon: @image-url("icons/arrow-left.svg");
                text: @tr("返回");
                clicked => { root.back(); }
            }
        }

        HorizontalLayout {
            alignment: center;
            vertical-stretch: 1;
            FilledCard {
                width: min(640px, root.width - 160px);
                MaterialText {
                    x: 32px;
                    y: 24px;
                    text: @tr("设置");
                    style: MaterialTypography.headline_small;
                }

                // 语言切换: 立即生效 (bundled translations), 重启后回系统 locale
                HorizontalLayout {
                    x: 32px;
                    y: 60px;
                    spacing: 8px;
                    MaterialText {
                        text: @tr("语言");
                        style: MaterialTypography.body_large;
                        color: MaterialPalette.on_surface_variant;
                        vertical-alignment: center;
                    }

                    TextButton {
                        text: "中文";
                        clicked => { root.set-language("zh"); }
                    }

                    TextButton {
                        text: "English";
                        clicked => { root.set-language("en"); }
                    }
                }

                MaterialText {
                    x: 32px;
                    y: 108px;
                    width: parent.width - 64px;
                    text: root.settings-text;
                    style: MaterialTypography.body_large;
                    color: MaterialPalette.on_surface_variant;
                }

                MaterialText {
                    x: 32px;
                    y: parent.height - 52px;
                    width: parent.width - 64px;
                    text: @tr("更多设置项开发中, 当前为只读配置信息");
                    style: MaterialTypography.body_small;
                    color: MaterialPalette.outline;
                }
            }
        }
    }
}
