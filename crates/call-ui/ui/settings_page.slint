// 设置页 (只读配置信息)
import {
    FilledCard,
    TextButton,
    MaterialText,
    MaterialTypography,
    MaterialPalette,
} from "../material-1.1.0/material.slint";

export component SettingsPage inherits Rectangle {
    in property <string> settings-text;
    callback back();

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            alignment: start;
            TextButton {
                icon: @image-url("icons/arrow-left.svg");
                text: @tr("返回");
                clicked => { root.back(); }
            }
        }

        HorizontalLayout {
            alignment: center;
            vertical-stretch: 1;
            FilledCard {
                width: min(640px, root.width - 160px);
                MaterialText {
                    x: 32px;
                    y: 24px;
                    text: @tr("设置");
                    style: MaterialTypography.headline_small;
                }

                MaterialText {
                    x: 32px;
                    y: 76px;
                    width: parent.width - 64px;
                    text: root.settings-text;
                    style: MaterialTypography.body_large;
                    color: MaterialPalette.on_surface_variant;
                }

                MaterialText {
                    x: 32px;
                    y: parent.height - 52px;
                    width: parent.width - 64px;
                    text: @tr("更多设置项开发中, 当前为只读配置信息");
                    style: MaterialTypography.body_small;
                    color: MaterialPalette.outline;
                }
            }
        }
    }
}
