// 设置页: 组装通用设置卡 + 摄像头管理卡 + 摄像头对话框
// 子组件在 settings/ 目录: GeneralSettingsCard / CamerasCard / CameraDialogs
import {
    TextButton,
    MaterialPalette,
} from "../material-1.1.0/material.slint";
import { ScrollView } from "std-widgets.slint";
import { CameraEntry, DiscoveredEntry, ProfileEntry } from "components.slint";
import { GeneralSettingsCard } from "settings/general_card.slint";
import { CamerasCard } from "settings/cameras_card.slint";
import { CameraDialogs } from "settings/camera_dialogs.slint";

export component SettingsPage inherits Rectangle {
    in property <[CameraEntry]> cameras: [];
    in property <bool> camera-busy: false;
    in property <[DiscoveredEntry]> discovered-devices: [];
    in property <[ProfileEntry]> camera-profiles: [];
    in-out property <string> city: ""; // 天气城市, 主窗口从 kv 读入
    in-out property <string> weather-key: ""; // 和风 key (可选)
    in property <string> resolved-city: ""; // 当前生效城市 (worker 定位结果)
    callback back();
    callback set-language(string); // "zh" | "en"
    callback set-city(string); // 留空 = IP 自动定位
    callback set-weather-key(string); // 留空 = Open-Meteo
    callback add-camera(string, string, string, string);
    callback delete-camera(int);
    callback search-cameras();
    callback fetch-camera-profiles(string, string, string);
    callback save-discovered-camera(string, string, string, string, string);
    callback show-toast(string);
    // 屏幕键盘聚焦登记透传 (KbTextField → 根部 → Rust)
    callback kb-field-focused(int);

    background: MaterialPalette.background;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            alignment: start;
            TextButton {
                icon: @image-url("icons/arrow-left.svg");
                text: @tr("返回");
                clicked => { root.back(); }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            // 卡片水平居中: VerticalLayout 的 alignment 只管纵轴,
            // 横轴居中要套 HorizontalLayout
            VerticalLayout {
                alignment: start;
                spacing: 16px;

                HorizontalLayout {
                    alignment: center;
                    GeneralSettingsCard {
                        // 宽度基准用页面宽度, 不能用父布局 (ScrollView 内容宽度
                        // 反过来依赖子元素, 构成绑定环)
                        width: min(640px, root.width - 48px);
                        city <=> root.city;
                        weather-key <=> root.weather-key;
                        resolved-city: root.resolved-city;
                        set-language(lang) => { root.set-language(lang); }
                        set-city(city) => { root.set-city(city); }
                        set-weather-key(key) => { root.set-weather-key(key); }
                        kb-field-focused(id) => { root.kb-field-focused(id); }
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    CamerasCard {
                        width: min(640px, root.width - 48px);
                        cameras: root.cameras;
                        delete-camera(id) => { root.delete-camera(id); }
                        // 搜索添加: 开对话框 + 立即触发一次扫描
                        search-clicked => {
                            dialogs.open-search();
                            root.search-cameras();
                        }
                        manual-clicked => { dialogs.open-manual(); }
                    }
                }
            }
        }
    }

    // 对话框覆盖层声明在最后, 绘制在上层
    dialogs := CameraDialogs {
        width: 100%;
        height: 100%;
        camera-busy: root.camera-busy;
        discovered-devices: root.discovered-devices;
        camera-profiles: root.camera-profiles;
        search-cameras => { root.search-cameras(); }
        fetch-camera-profiles(xaddr, user, pass) => { root.fetch-camera-profiles(xaddr, user, pass); }
        save-discovered-camera(xaddr, name, user, pass, token) => {
            root.save-discovered-camera(xaddr, name, user, pass, token);
        }
        add-camera(name, uri, user, pass) => { root.add-camera(name, uri, user, pass); }
        kb-field-focused(id) => { root.kb-field-focused(id); }
    }
}
