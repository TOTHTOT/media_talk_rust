// 设置页: 组装通用设置卡 + 摄像头管理卡 + ICE 通话卡 + SIP 通话卡 + 摄像头对话框
// 子组件在 settings/ 目录: GeneralSettingsCard / CamerasCard / IceSettingsCard / SipSettingsCard / CameraDialogs
import {
    TextButton,
    MaterialPalette,
} from "../material-1.1.0/material.slint";
import { ScrollView } from "std-widgets.slint";
import { KeyboardCtx } from "kb_text_field.slint";
import { CameraEntry, DiscoveredEntry, ProfileEntry } from "components.slint";
import { GeneralSettingsCard } from "settings/general_card.slint";
import { CamerasCard } from "settings/cameras_card.slint";
import { CameraDialogs } from "settings/camera_dialogs.slint";
import { IceSettingsCard } from "settings/ice_card.slint";
import { SipSettingsCard } from "settings/sip_card.slint";

export component SettingsPage inherits Rectangle {
    in property <[CameraEntry]> cameras: [];
    in property <bool> camera-busy: false;
    in property <[DiscoveredEntry]> discovered-devices: [];
    in property <[ProfileEntry]> camera-profiles: [];
    in-out property <string> city: ""; // 天气城市, 主窗口从 kv 读入
    in-out property <string> weather-key: ""; // 和风 key (可选)
    in property <string> resolved-city: ""; // 当前生效城市 (worker 定位结果)
    in-out property <float> screen-brightness: 80;
    // ICE 通话卡穿透 (ice_card.slint 本体, 属性/回调经主窗口直达 Rust)
    in-out property <string> ice-sigserver: ""; // sigserver WS 地址
    in-out property <string> ice-room: ""; // 信令房间名
    in-out property <string> ice-stun: ""; // STUN URI, 留空 = 仅 host 候选
    in property <string> ice-status-text: ""; // 状态行文案 (ice worker 投递)
    in property <string> ice-stats-text: ""; // 收发统计行 (ice worker 投递)
    // SIP 通话卡穿透 (sip_card.slint 本体, 属性/回调经主窗口直达 Rust)
    in-out property <string> sip-server: ""; // SIP 服务器 ip:port
    in-out property <string> sip-username: ""; // SIP 账号
    in-out property <string> sip-password: ""; // 账号密码
    in-out property <string> sip-expires: ""; // 注册有效期 (秒)
    in-out property <string> sip-stun: ""; // STUN URI, 留空 = 仅 host 候选
    in-out property <string> sip-local-ip: ""; // 本机 IPv4, 留空 = 自动选网卡
    in-out property <string> sip-video-src: ""; // 视频源原始串
    in-out property <string> sip-audio-src: ""; // 音频源原始串
    in-out property <string> sip-width-limit: ""; // 视频限宽, 0 = 不限
    in-out property <string> sip-rtp-audio: ""; // 音频 RTP 首选端口
    in-out property <string> sip-rtp-video: ""; // 视频 RTP 首选端口
    in-out property <bool> sip-ice-enabled: false; // SIP ICE 开关
    // 抬升门控: 聚焦字段的页内纵坐标 (内容空间, 由卡片焦点处理器写入);
    in-out property <length> focused-page-y: 0px;
    property <length> scroll-y: sv.content-y;

    changed scroll-y => {
        root.update-lift();
    }

    // 遮挡判定 (页内坐标系): 键盘占窗口底部 45%, 换算到页内其顶约
    // 55% 页高 - 状态栏 slack(24px); 字段底部 (y + 56px 键高) 越过该线
    // 即被遮 —— 需要抬升. 页眉/返回行经 sv.y 计入, 不重不漏.
    function update-lift() {
        KeyboardCtx.lift-needed = root.focused-page-y + root.scroll-y + 56px > root.height * 55% - 24px;
    }

    callback back();
    callback set-language(string); // "zh" | "en"
    callback set-city(string); // 留空 = IP 自动定位
    callback set-weather-key(string); // 留空 = Open-Meteo
    callback set-screen-brightness(float);
    callback ice-call();
    callback ice-hangup();
    callback set-ice-sigserver(string);
    callback set-ice-room(string);
    callback set-ice-stun(string);
    callback set-sip-server(string);
    callback set-sip-username(string);
    callback set-sip-password(string);
    callback set-sip-expires(string);
    callback set-sip-stun(string);
    callback set-sip-local-ip(string);
    callback set-sip-video-src(string);
    callback set-sip-audio-src(string);
    callback set-sip-max-width(string);
    callback set-sip-rtp-audio(string);
    callback set-sip-rtp-video(string);
    callback set-sip-ice(bool);
    callback add-camera(string, string, string, string);
    callback delete-camera(int);
    callback search-cameras();
    callback fetch-camera-profiles(string, string, string);
    callback save-discovered-camera(string, string, string, string, string);
    callback show-toast(string);
    // 屏幕键盘聚焦登记透传 (KbTextField → 根部 → Rust)

    background: MaterialPalette.background;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            alignment: start;
            TextButton {
                icon: @image-url("icons/arrow-left.svg");
                text: @tr("返回");
                clicked => { root.back(); }
            }
        }

        sv := ScrollView {
            vertical-stretch: 1;
            // 卡片水平居中: VerticalLayout 的 alignment 只管纵轴,
            // 横轴居中要套 HorizontalLayout
            VerticalLayout {
                alignment: start;
                spacing: 16px;

                hl_general := HorizontalLayout {
                    alignment: center;
                    general_card := GeneralSettingsCard {
                        // 宽度基准用页面宽度, 不能用父布局 (ScrollView 内容宽度
                        // 反过来依赖子元素, 构成绑定环)
                        width: min(760px, root.width - 48px);
                        city <=> root.city;
                        weather-key <=> root.weather-key;
                        resolved-city: root.resolved-city;
                        brightness <=> root.screen-brightness;
                        set-language(lang) => { root.set-language(lang); }
                        set-city(city) => { root.set-city(city); }
                        set-weather-key(key) => { root.set-weather-key(key); }
                        set-brightness(v) => { root.set-screen-brightness(v); }
                    
                        kb-field-focused(f) => {
                            if f {
                                root.focused-page-y = sv.y + hl_general.y + general_card.focus-offset-y;
                                root.update-lift();
                            }
                        }
                    }
                }

                hl_cameras := HorizontalLayout {
                    alignment: center;
                    CamerasCard {
                        width: min(760px, root.width - 48px);
                        cameras: root.cameras;
                        delete-camera(id) => { root.delete-camera(id); }
                        // 搜索添加: 开对话框 + 立即触发一次扫描
                        search-clicked => {
                            dialogs.open-search();
                            root.search-cameras();
                        }
                        manual-clicked => { dialogs.open-manual(); }
                    }
                }

                // ICE 通话卡 (卡片本体 Task 7): 设置/呼叫/状态行
                hl_ice := HorizontalLayout {
                    alignment: center;
                    ice_card := IceSettingsCard {
                        // 宽度基准用页面宽度, 不能用父布局 (ScrollView 内容宽度
                        // 反过来依赖子元素, 构成绑定环)
                        width: min(760px, root.width - 48px);
                        sigserver <=> root.ice-sigserver;
                        room <=> root.ice-room;
                        stun <=> root.ice-stun;
                        status-text: root.ice-status-text;
                        stats-text: root.ice-stats-text;
                        ice-call => { root.ice-call(); }
                        ice-hangup => { root.ice-hangup(); }
                        set-sigserver(v) => { root.set-ice-sigserver(v); }
                        set-room(v) => { root.set-ice-room(v); }
                        set-stun(v) => { root.set-ice-stun(v); }
                    
                        kb-field-focused(f) => {
                            if f {
                                root.focused-page-y = sv.y + hl_ice.y + ice_card.focus-offset-y;
                                root.update-lift();
                            }
                        }
                    }
                }

                // SIP 通话卡: 服务器/账号/媒体源设置, 写 kv 下次呼叫生效
                hl_sip := HorizontalLayout {
                    alignment: center;
                    sip_card := SipSettingsCard {
                        // 宽度基准用页面宽度, 不能用父布局 (ScrollView 内容宽度
                        // 反过来依赖子元素, 构成绑定环)
                        width: min(760px, root.width - 48px);
                        server <=> root.sip-server;
                        username <=> root.sip-username;
                        password <=> root.sip-password;
                        expires <=> root.sip-expires;
                        stun <=> root.sip-stun;
                        local-ip <=> root.sip-local-ip;
                        video-src <=> root.sip-video-src;
                        audio-src <=> root.sip-audio-src;
                        width-limit <=> root.sip-width-limit;
                        rtp-audio <=> root.sip-rtp-audio;
                        rtp-video <=> root.sip-rtp-video;
                        ice-enabled <=> root.sip-ice-enabled;
                        set-server(v) => { root.set-sip-server(v); }
                        set-username(v) => { root.set-sip-username(v); }
                        set-password(v) => { root.set-sip-password(v); }
                        set-expires(v) => { root.set-sip-expires(v); }
                        set-stun(v) => { root.set-sip-stun(v); }
                        set-local-ip(v) => { root.set-sip-local-ip(v); }
                        set-video-src(v) => { root.set-sip-video-src(v); }
                        set-audio-src(v) => { root.set-sip-audio-src(v); }
                        set-max-width(v) => { root.set-sip-max-width(v); }
                        set-rtp-audio(v) => { root.set-sip-rtp-audio(v); }
                        set-rtp-video(v) => { root.set-sip-rtp-video(v); }
                        set-ice(v) => { root.set-sip-ice(v); }
                        
                        kb-field-focused(f) => {
                            if f {
                                root.focused-page-y = sv.y + hl_sip.y + sip_card.focus-offset-y;
                                root.update-lift();
                            }
                        }
                    }
                }
            }
        }
    }

    // 对话框覆盖层声明在最后, 绘制在上层
    dialogs := CameraDialogs {
        width: 100%;
        height: 100%;
        camera-busy: root.camera-busy;
        discovered-devices: root.discovered-devices;
        camera-profiles: root.camera-profiles;
        search-cameras => { root.search-cameras(); }
        fetch-camera-profiles(xaddr, user, pass) => { root.fetch-camera-profiles(xaddr, user, pass); }
        save-discovered-camera(xaddr, name, user, pass, token) => {
            root.save-discovered-camera(xaddr, name, user, pass, token);
        }
        add-camera(name, uri, user, pass) => { root.add-camera(name, uri, user, pass); }
        
    }
                    }
