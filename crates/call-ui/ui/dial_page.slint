// 拨号页: 组装左侧通讯录卡 + 右侧拨号盘
// 子组件在 dial/ 目录: ContactsCard / Dialpad
import { MaterialPalette, TextButton } from "../material-1.1.0/material.slint";
import { ContactEntry } from "components.slint";
import { ContactsCard } from "dial/contacts_card.slint";
import { Dialpad } from "dial/dialpad.slint";

export component DialPage inherits Rectangle {
    background: MaterialPalette.background;
    in property <[ContactEntry]> contacts: [];
    callback back();
    callback dial(string);
    callback trigger-error(string);
    // 通讯录 CRUD: 数据落 SQLite, Rust 侧 store.rs
    callback add-contact(string, string);
    callback update-contact(int, string, string);
    callback delete-contact(int);

    VerticalLayout {
        padding-left: 24px;
        padding-bottom: 24px;
        padding-right: 24px;
        spacing: 12px;
        HorizontalLayout {
            alignment: start;
            TextButton {
                icon: @image-url("icons/arrow-left.svg");
                text: @tr("返回");
                clicked => { root.back(); }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;
            ContactsCard {
                horizontal-stretch: 2;
                contacts: root.contacts;
                add-contact(name, num) => { root.add-contact(name, num); }
                update-contact(id, name, num) => { root.update-contact(id, name, num); }
                delete-contact(id) => { root.delete-contact(id); }
                // 点联系人行 → 号码填进拨号盘
                pick-number(num) => { dialpad.number-text = num; }
                dial(num) => { root.dial(num); }
            }

            dialpad := Dialpad {
                horizontal-stretch: 3;
                dial(num) => { root.dial(num); }
            }
        }
    }
}
