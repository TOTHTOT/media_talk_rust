// 通话中: 视频铺满 + 开锁/挂断
import { ButtonIntent, KitButton, KitThemeContext } from "@kit";

export component InCallPage inherits Rectangle {
    in property <image> video-frame;
    callback hangup();
    callback show-toast(string);

    background: black;
    Image {
        source: root.video-frame;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    HorizontalLayout {
        // Layout 默认铺满父级, 必须显式收缩到内容尺寸, 否则按钮被拉伸成半屏
        width: self.preferred-width;
        height: self.preferred-height;
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 24px;
        spacing: KitThemeContext.current.spacing.unit * 3;
        KitButton {
            text: @tr("开锁");
            activated => { root.show-toast(@tr("开锁功能开发中 (需 DTMF 支持)")); }
        }

        KitButton {
            text: @tr("挂断");
            intent: ButtonIntent.destructive;
            activated => { root.hangup(); }
        }
    }
}
