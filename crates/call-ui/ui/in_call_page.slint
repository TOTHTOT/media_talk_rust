// 通话中: 视频铺满 + 开锁/挂断
import { FilledButton, TonalButton } from "../material-1.1.0/material.slint";

export component InCallPage inherits Rectangle {
    in property <image> video-frame;
    callback hangup();
    callback show-toast(string);

    background: black;
    Image {
        source: root.video-frame;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }
    HorizontalLayout {
        x: parent.width - self.width - 24px;
        y: parent.height - self.height - 24px;
        spacing: 12px;
        TonalButton {
            text: @tr("开锁");
            clicked => { root.show-toast(@tr("开锁功能开发中 (需 DTMF 支持)")); }
        }
        FilledButton {
            text: @tr("挂断");
            clicked => { root.hangup(); }
        }
    }
}
