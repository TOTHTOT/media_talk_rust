// 主窗口: 组装各页面/状态栏/覆盖层, 持有跨页面共享状态 (toast/page)
// 组件集: Slint Kit (统一主题/组件); 文本输入例外见 kb_text_field.slint.
// phase: 0=Idle 1=Outgoing 2=Incoming 3=InCall (与 app.rs Phase 一一对应)
// Idle 下再分子页面 page: 0=主页 1=拨号 2=设置 3=监控 (纯 UI 状态, 不进状态机)
import { KitAppShell, KitThemeContext, KitThemes } from "@kit";
import {
    CallLogEntry,
    ContactEntry,
    CameraEntry,
    DiscoveredEntry,
    ProfileEntry,
    AppToast,
    ErrorBanner,
} from "components.slint";
import { OutgoingCallOverlay } from "components/outgoing_call.slint";
import { IncomingCallOverlay } from "components/incoming_call.slint";
import { StatusBar } from "status_bar.slint";
import { Keyboard } from "keyboard.slint";
import { KeyboardCtx } from "kb_text_field.slint";
// Rust 侧实现 KbTextField 的退格 trim-last 回调
export { KeyboardCtx } from "kb_text_field.slint";
import { HomePage } from "home_page.slint";
import { DialPage } from "dial_page.slint";
import { SettingsPage } from "settings_page.slint";
import { MonitorPage } from "monitor_page.slint";
import { InCallPage } from "in_call_page.slint";

export component MainWindow inherits Window {
    in property <int> phase: 0;
    in property <string> peer: "";
    in-out property <string> error-text: "";
    in property <image> video-frame;
    // 主页状态 (Rust 侧驱动)
    in property <bool> sip-registered: false;
    in property <string> account: "";
    // 时钟: 后端只发原始时间组件, 格式化与翻译全在下方 @tr —
    // 后端不感知语言, 新增语言只改 lang/*.po
    in property <int> clock-hour: -1;
    in property <int> clock-minute: 0;
    in property <int> date-month: 1;
    in property <int> date-day: 1;
    in property <int> weekday-index: 0; // 0=周一 .. 6=周日
    // 星期只保留一种形式 (短版), 主页日期与状态栏共用
    property <[string]> weekdays: [
        @tr("周一"),
        @tr("周二"),
        @tr("周三"),
        @tr("周四"),
        @tr("周五"),
        @tr("周六"),
        @tr("周日")
    ];
    property <string> weekday: weekdays[weekday-index];
    property <string> clock-text: clock-hour < 0 ? "--:--" :
        (clock-hour < 10 ? "0" : "") + clock-hour + ":" +
        (clock-minute < 10 ? "0" : "") + clock-minute;
    // @tr 只支持顺序占位 {}, 翻译侧可用 {0}/{1}/... 重排 (en: 星期提前)
    property <string> date-text: @tr("{}月{}日 {}", date-month, date-day, weekday);
    property <string> status-time-text: @tr("{}  {} {}/{}", clock-text, weekday, date-month, date-day);
    in property <int> today-visitors: 0;
    in property <int> unread-messages: 0;
    // 天气: icon 为 lucide 索引, -1 = 无数据 (weather 刷新任务投递)
    in property <int> weather-icon: -1;
    in property <string> weather-temp: "";
    // 定位解析出的城市名 (weather 刷新任务投递), 设置页"当前城市"提示
    in property <string> weather-resolved-city: "";
    // 设置页城市输入框初始值 (Rust 启动时从 kv 读入)
    in-out property <string> weather-city: "";
    in-out property <string> weather-key: "";
    // ICE 通话 (设置页 ICE 卡片属性/回调穿透, 卡片本体在 settings/ice_card.slint):
    // sigserver/room/stun 初值由 Rust 启动时从 kv 播种
    in property <string> ice-status-text: "";
    in property <string> ice-stats-text: "";
    in-out property <string> ice-sigserver: "";
    in-out property <string> ice-room: "";
    in-out property <string> ice-stun: "";
    // SIP 通话 (设置页 SIP 卡片属性/回调穿透, 卡片本体在 settings/sip_card.slint):
    // 初值由 Rust 启动时从 resolve 合成结果刷入
    in-out property <string> sip-server: "";
    in-out property <string> sip-username: "";
    in-out property <string> sip-password: "";
    in-out property <string> sip-expires: "";
    in-out property <string> sip-stun: "";
    in-out property <string> sip-local-ip: "";
    in-out property <string> sip-video-src: "";
    in-out property <string> sip-audio-src: "";
    in-out property <string> sip-width-limit: "";
    in-out property <string> sip-rtp-audio: "";
    in-out property <string> sip-rtp-video: "";
    in-out property <bool> sip-ice-enabled: false;
    in property <[CallLogEntry]> call-log: [];
    in property <[ContactEntry]> contacts: [];
    in property <[CameraEntry]> cameras: [];
    // 摄像头操作忙标志 (搜索中/拉 profile 中), 对话框里转菊花文案
    in property <bool> camera-busy: false;
    in property <[DiscoveredEntry]> discovered-devices: [];
    in property <[ProfileEntry]> camera-profiles: [];
    in property <int> monitor-selected-id: -1;
    // 熄屏: 仅 RK3566 支持真实关闭显示; 其他平台由状态栏按钮弹 toast.
    // screen-off 由 Rust 在硬件操作成功后回写, 控制全屏遮罩与触摸唤醒.
    in property <bool> screen-control-available: false;
    in property <bool> screen-off: false;
    // 屏幕亮度: 所有平台都显示滑块, 不支持时松手弹 toast
    in-out property <float> screen-brightness: 80;
    // 自动休眠时间 (秒, 0 = 永不)
    // 自动休眠: 选项下标 (语义见 GeneralSettingsCard.sleep-timeout-index)
    in-out property <int> sleep-timeout-index: 2;
    callback dial(string);
    callback accept-call();
    callback reject-call();
    callback hangup();
    callback set-language(string); // "zh" | "en"
    // 天气城市设置 (留空 = IP 自动定位), 持久化在 kv 表
    callback set-city(string);
    // 和风 API KEY (可选), 持久化在 kv 表
    callback set-weather-key(string);
    // ICE 通话 (设置页 ICE 卡片, 本体在 settings/ice_card.slint)
    callback ice-call();
    callback ice-hangup();
    callback set-ice-sigserver(string);
    callback set-ice-room(string);
    callback set-ice-stun(string);
    // SIP 通话 (设置页 SIP 卡片, 本体在 settings/sip_card.slint)
    callback set-sip-server(string);
    callback set-sip-username(string);
    callback set-sip-password(string);
    callback set-sip-expires(string);
    callback set-sip-stun(string);
    callback set-sip-local-ip(string);
    callback set-sip-video-src(string);
    callback set-sip-audio-src(string);
    callback set-sip-max-width(string);
    callback set-sip-rtp-audio(string);
    callback set-sip-rtp-video(string);
    callback set-sip-ice(bool);
    // 通讯录 CRUD (SQLite 持久化在 Rust store.rs)
    callback add-contact(string, string);
    callback update-contact(int, string, string);
    callback delete-contact(int);
    // 摄像头管理 (设置页): 手动添加/删除/ONVIF 搜索/拉 profile/保存搜索到的设备
    callback add-camera(string, string, string, string); // name, uri, user, pass
    callback delete-camera(int);
    callback search-cameras();
    callback fetch-camera-profiles(string, string, string); // xaddr, user, pass
    callback save-discovered-camera(string, string, string, string, string); // xaddr, name, user, pass, token
    // 监控页: 选中查看 / 离开停止 (Rust 侧 MonitorController)
    callback monitor-select(int);
    callback monitor-leave();
    // 熄屏开关: 状态栏电源键 / 熄屏遮罩任意点击唤醒
    callback screen-power-pressed();
    callback screen-wake();
    // 自动熄屏心跳: Slint Timer 每秒在 UI 线程触发, Rust 侧判断空闲
    callback sleep-tick();
    // 屏幕亮度调节 (设置页滑块松手时提交)
    callback set-screen-brightness(float);
    callback set-sleep-timeout-index(int);
    // 后端通知管线入口 (app.rs Notice): 前端按 kind 解析文案 (i18n),
    // level 决定呈现 (0 info / 1 warn → toast, 2 error → 顶部错误条),
    // detail 可选 (空串 = 无), 用于系统错误原文或后端指定提示
    callback notify(level: int, kind: int, detail: string);

    // 屏幕键盘属性表 (实施计划 Task 2; Rust 侧 KeyboardController 装配回写,
    // 聚焦的 KbTextField 监听 kb-commit-seq 拍振完成上屏)
    in property <bool> kb-visible: false;
    in property <int> kb-mode: 0; // 0=zh 1=en 2=num
    in property <bool> kb-zh-available: false;
    in property <string> kb-preedit: "";
    in property <[string]> kb-candidates: [];
    // 上屏拍振: 每次上屏 seq +1, text 为追加文本; delete-field=true 时删输入框末字符
    in property <int> kb-commit-seq: 0;
    in property <string> kb-commit-text: "";
    in property <bool> kb-delete-field: false;
    callback kb-key-tapped(string);
    callback kb-backspace();
    callback kb-candidate(int);
    callback kb-space();
    // slint 不允许属性与回调同名, 契约中的 kb-mode(int) 回调改名 kb-set-mode
    callback kb-set-mode(int);
    callback kb-dismiss();
    // 输入框聚焦登记: field-id 聚焦 / -1 全失焦 (wiring.rs → controller.set_focus)
    callback kb-any-field-focused(bool);

    // 方案 D (键盘显隐交给 slint 官方状态): 显隐 =
    // TextInputInterface.text-input-focused && !KeyboardCtx.collapsed.
    // collapsed 闩由 "收起/完成"键与点空白置位, 全失焦复位 (本处理器);
    // 收起同时经 fs.focus() 释放输入框焦点, 使再点同一输入框产生新的
    // focus-in 重新唤出. 逐字段 focused-id 登记已整体移除 — Rust 提交
    // 门控只问 "有无聚焦框" (本镜像经 kb-any-field-focused 喂给控制器).
    property <bool> any-field-focused: TextInputInterface.text-input-focused;
    changed any-field-focused => {
        KeyboardCtx.collapsed = false; // 闩随真实失焦复位 (gain 时本就未收)
        if !root.any-field-focused {
            KeyboardCtx.lift-offset = 0px; // 抬升量随失焦复位
        }
        root.kb-any-field-focused(root.any-field-focused);
    }
    // 键盘实际显隐 (显隐条件唯一出处: 浮层显隐 + 内容上抬共用)
    property <bool> kb-showing: TextInputInterface.text-input-focused && !KeyboardCtx.collapsed;
    changed kb-visible => {
        if !root.kb-visible {
            KeyboardCtx.collapsed = true;
            fs.focus();
        }
    }
    changed kb-commit-seq => { KeyboardCtx.commit-seq = root.kb-commit-seq; }
    changed kb-commit-text => { KeyboardCtx.commit-text = root.kb-commit-text; }
    changed kb-delete-field => { KeyboardCtx.delete-field = root.kb-delete-field; }

    property <string> displayed-error <=> root.error-text;

    error-timer := Timer {
        interval: 2s;
        running: root.displayed-error != "";
        triggered => {
            root.displayed-error = "";
        }
    }

    // 通知文案: kind 与 app.rs NoticeKind 一一对应 (0=Raw 1=RegisterFailed
    // 2=CallFailed 3=CameraSaved 4=CameraSaveFailed 5=CameraConnectFailed
    // 6=CameraDuplicate 7=ScreenFailed 8=BrightnessUnsupported),
    // 按 kind 出本地化文案; detail 可选, 原样附加不翻译
    function notice-msg(kind: int, detail: string) -> string {
        if (kind == 1) {
            return detail == "" ? @tr("注册失败") : @tr("注册失败") + ": " + detail;
        }
        if (kind == 2) {
            return detail == "" ? @tr("呼叫失败") : @tr("呼叫失败") + ": " + detail;
        }
        if (kind == 3) {
            return @tr("摄像头已保存");
        }
        if (kind == 4) {
            return detail == "" ? @tr("摄像头保存失败") : @tr("摄像头保存失败") + ": " + detail;
        }
        if (kind == 5) {
            return detail == "" ? @tr("摄像头连接失败") : @tr("摄像头连接失败") + ": " + detail;
        }
        if (kind == 6) {
            return @tr("该设备已存在, 未重复添加");
        }
        if (kind == 7) {
            return detail == "" ? @tr("屏幕控制失败") : @tr("屏幕控制失败") + ": " + detail;
        }
        if (kind == 8) {
            return @tr("当前平台不支持亮度调节");
        }
        return detail;
    }
    notify(level, kind, detail) => {
        if (detail == "" && kind == 0) {
            return;
        }
        if (level == 2) {
            root.error-text = notice-msg(kind, detail);
        } else {
            root.show-toast(notice-msg(kind, detail));
        }
    }

    // 纯 UI 状态: 子页面与气泡提示, 不进 Rust 状态机
    // out: Rust 侧自动熄屏需要读当前页面 (监控页保持亮屏)
    out property <int> page: 0;
    property <string> toast: "";
    // toast 队列: 当前有气泡在显示时新消息排队, 前一条消失后依次展示 (每条 1 秒)
    property <[string]> toast-queue: [];
    function show-toast(t: string) {
        if (root.toast == "") {
            root.toast = t;
        } else if (toast-queue.length < 5) {
            // 连点防爆: 积压超过 5 条直接丢弃
            toast-queue.push(t);
        }
    }

    toast-timer := Timer {
        interval: 1s;
        // running 跟随 toast 非空: 队列续杯时保持 true, 计时器连续触发 (每条各 1 秒)
        running: root.toast != "";
        triggered => {
            if (root.toast-queue.length > 0) {
                root.toast = root.toast-queue[0];
                root.toast-queue.remove(0);
            } else {
                root.toast = "";
            }
        }
    }

    title: "media_talk";
    preferred-width: 1024px;
    preferred-height: 600px;
    min-width: 1024px;
    min-height: 600px;

    // Kit 主题是唯一视觉来源.
    // 1024x600 触摸屏上默认 14/16/20px 图标偏小, 整体放大一档.
    init => {
        KitThemeContext.current = KitThemes.light;
        KitThemeContext.current.geometry.icon-compact = 16px;
        KitThemeContext.current.geometry.icon-medium = 20px;
        KitThemeContext.current.geometry.icon-comfortable = 24px;
        // 品牌色 teal-700: 与安防/家居气质一致, 白字对比度足够;
        // choice/selection 一起换, 避免单选框和选中行仍是旧紫色.
        KitThemeContext.current.accent = #0f766e;
        KitThemeContext.current.accent-hover = #115e59;
        KitThemeContext.current.accent-pressed = #134e4a;
        KitThemeContext.current.accent-subtle = #f0fdfa;
        KitThemeContext.current.on-accent = #ffffff;
        KitThemeContext.current.choice-fill = #0f766e;
        KitThemeContext.current.on-choice-fill = #ffffff;
        KitThemeContext.current.selection = #ccfbf1;
        KitThemeContext.current.on-selection = #0f172a;
        // 触摸屏上不显示焦点环; 键盘/遥控器仍可操作, 但没有可见的焦点提示.
        // invalid-color 保留, 校验失败的红框仍可见.
        KitThemeContext.current.focus.width = 1px;
        KitThemeContext.current.focus.offset = 0px;
        KitThemeContext.current.focus.color = transparent;
        // 键盘几何: 顶边在窗口 55% 处, 最大抬升 45% 窗口高.
        KeyboardCtx.keyboard-top = root.height * 55% - 24px;
        KeyboardCtx.lift-max = root.height * 45%;
    }
    changed height => {
        KeyboardCtx.keyboard-top = root.height * 55% - 24px;
        KeyboardCtx.lift-max = root.height * 45%;
    }
    background: KitThemeContext.current.canvas;

    // ===== 屏幕键盘兜底 (z 序最低, 先于页面内容声明): 全窗背景点击区 +
    // 隐藏焦点汇. 背景 TouchArea 压在页面内容之下, 点按钮/输入框仍由上层
    // 元素消费, 只有点空白处才落到这里 — 方案 D 语义: 置收起闩并抢焦点,
    // 不直接写显隐 (显隐 = text-input-focused && !collapsed) =====
    TouchArea {
        clicked => {
            if TextInputInterface.text-input-focused && !KeyboardCtx.collapsed {
                KeyboardCtx.collapsed = true;
                fs.focus();
            }
        }
    }

    fs := FocusScope {
        width: 1px;
        height: 1px;
    }

    // ===== 根布局: 状态栏 + 主页区域, 靠 spacing 控制间距.
    // 抬升语义: 键盘弹出时整体 y 上移键盘高度 (45%), 底部输入框随界面上抬
    // 露出 (顶部内容暂时让位, 收起即回); 不做逐字段滚动 =====
    shell := KitAppShell {
        y: root.kb-showing ? -KeyboardCtx.lift-offset : 0px;
        animate y {
            duration: 150ms;
            easing: ease-out;
        }

        // 状态栏 (通话视频全屏时隐藏)
        if root.phase != 3: StatusBar {
            sip-registered: root.sip-registered;
            account: root.account;
            status-time-text: root.status-time-text;
            screen-control-available: root.screen-control-available;
            show-toast(t) => { root.show-toast(t); }
            screen-power-pressed => { root.screen-power-pressed(); }
        }

        // 主页内容区: 根据 phase / page 切换子页面,
        // Rectangle 撑满剩余空间, 背景随主题色
        Rectangle {
            background: KitThemeContext.current.canvas;

            // 主页
            if root.phase == 0 && root.page == 0: HomePage {
                sip-registered: root.sip-registered;
                clock-text: root.clock-text;
                date-text: root.date-text;
                unread-messages: root.unread-messages;
                today-visitors: root.today-visitors;
                weather-icon: root.weather-icon;
                weather-temp: root.weather-temp;
                call-log: root.call-log;
                show-toast(t) => { root.show-toast(t); }
                open-page(p) => { root.page = p; }
                redial(num) => { root.dial(num); }
            }

            // 拨号页
            if root.phase == 0 && root.page == 1: DialPage {
                contacts: root.contacts;
                back => { root.page = 0; }
                dial(num) => { root.dial(num); }
                add-contact(name, num) => { root.add-contact(name, num); }
                update-contact(id, name, num) => { root.update-contact(id, name, num); }
                delete-contact(id) => { root.delete-contact(id); }
            }

            // 设置页
            if root.phase == 0 && root.page == 2: SettingsPage {
                cameras: root.cameras;
                camera-busy: root.camera-busy;
                discovered-devices: root.discovered-devices;
                camera-profiles: root.camera-profiles;
                city: root.weather-city;
                weather-key: root.weather-key;
                resolved-city: root.weather-resolved-city;
                screen-brightness <=> root.screen-brightness;
                sleep-timeout-index <=> root.sleep-timeout-index;
                // ICE 卡片穿透 (本体在 settings/ice_card.slint, 这里打通属性/回调)
                ice-sigserver <=> root.ice-sigserver;
                ice-room <=> root.ice-room;
                ice-stun <=> root.ice-stun;
                ice-status-text: root.ice-status-text;
                ice-stats-text: root.ice-stats-text;
                ice-call => { root.ice-call(); }
                ice-hangup => { root.ice-hangup(); }
                set-ice-sigserver(v) => { root.set-ice-sigserver(v); }
                set-ice-room(v) => { root.set-ice-room(v); }
                set-ice-stun(v) => { root.set-ice-stun(v); }
                // SIP 卡片穿透 (本体在 settings/sip_card.slint, 这里打通属性/回调)
                sip-server <=> root.sip-server;
                sip-username <=> root.sip-username;
                sip-password <=> root.sip-password;
                sip-expires <=> root.sip-expires;
                sip-stun <=> root.sip-stun;
                sip-local-ip <=> root.sip-local-ip;
                sip-video-src <=> root.sip-video-src;
                sip-audio-src <=> root.sip-audio-src;
                sip-width-limit <=> root.sip-width-limit;
                sip-rtp-audio <=> root.sip-rtp-audio;
                sip-rtp-video <=> root.sip-rtp-video;
                sip-ice-enabled <=> root.sip-ice-enabled;
                set-sip-server(v) => { root.set-sip-server(v); }
                set-sip-username(v) => { root.set-sip-username(v); }
                set-sip-password(v) => { root.set-sip-password(v); }
                set-sip-expires(v) => { root.set-sip-expires(v); }
                set-sip-stun(v) => { root.set-sip-stun(v); }
                set-sip-local-ip(v) => { root.set-sip-local-ip(v); }
                set-sip-video-src(v) => { root.set-sip-video-src(v); }
                set-sip-audio-src(v) => { root.set-sip-audio-src(v); }
                set-sip-max-width(v) => { root.set-sip-max-width(v); }
                set-sip-rtp-audio(v) => { root.set-sip-rtp-audio(v); }
                set-sip-rtp-video(v) => { root.set-sip-rtp-video(v); }
                set-sip-ice(v) => { root.set-sip-ice(v); }
                back => { root.page = 0; }
                set-language(lang) => { root.set-language(lang); }
                set-city(city) => { root.set-city(city); }
                set-weather-key(key) => { root.set-weather-key(key); }
                set-screen-brightness(v) => { root.set-screen-brightness(v); }
                set-sleep-timeout-index(v) => { root.set-sleep-timeout-index(v); }
                add-camera(n, u, user, p) => { root.add-camera(n, u, user, p); }
                delete-camera(id) => { root.delete-camera(id); }
                search-cameras => { root.search-cameras(); }
                fetch-camera-profiles(x, user, p) => { root.fetch-camera-profiles(x, user, p); }
                save-discovered-camera(x, n, user, p, t) => { root.save-discovered-camera(x, n, user, p, t); }
                show-toast(t) => { root.show-toast(t); }
            }

            // 监控页
            if root.phase == 0 && root.page == 3: MonitorPage {
                cameras: root.cameras;
                video-frame: root.video-frame;
                selected-id: root.monitor-selected-id;
                back => {
                    root.monitor-leave();
                    root.page = 0;
                }
                select-camera(id) => { root.monitor-select(id); }
                show-toast(t) => { root.show-toast(t); }
            }

            // 通话中 (全屏, 无状态栏)
            if root.phase == 3: InCallPage {
                width: 100%;
                height: 100%;
                video-frame: root.video-frame;
                hangup => { root.hangup(); }
                show-toast(t) => { root.show-toast(t); }
            }

            // 呼出中
            if root.phase == 1: OutgoingCallOverlay {
                peer: root.peer;
                hangup => { root.hangup(); }
            }

            // 来电
            if root.phase == 2: IncomingCallOverlay {
                peer: root.peer;
                accept-call => { root.accept-call(); }
                reject-call => { root.reject-call(); }
            }
        }
    }

    // ===== 错误条: 顶层浮层, 不参与主布局 =====
    ErrorBanner {
        y: 0;
        width: 100%;
        z: 2;
        text: root.displayed-error;
    }

    // ===== toast 浮条: 顶层浮层, 不参与主布局 =====
    AppToast {
        width: 100%;
        height: 100%;
        text: root.toast;
        shown: root.toast != "";
    }

    // ===== 屏幕键盘: 底部滑出浮层, 不参与主布局 (z 序最高的同级层).
    // 方案 D: 显隐 = slint 官方 TextInputInterface.text-input-focused &&
    // !KeyboardCtx.collapsed — 焦点驱动显隐, 收起键/完成键/点空白只操作
    // collapsed 闩 (复位在根部 any-field-focus changed 处理器) =====
    if root.kb-showing: Keyboard {
        width: 100%;
        y: parent.height - self.height;
        height: 45%;
        kb-mode: root.kb-mode;
        kb-zh-available: root.kb-zh-available;
        kb-preedit: root.kb-preedit;
        kb-candidates: root.kb-candidates;
        key-tapped(k) => {
            root.kb-key-tapped(k);
        }
        backspace => {
            root.kb-backspace();
        }
        candidate(i) => {
            root.kb-candidate(i);
        }
        space => {
            root.kb-space();
        }
        mode(m) => {
            root.kb-set-mode(m);
        }
        // 收起/完成同效: 置闩 + 释放输入框焦点 (收起键/完成键/点空白
        // 三条路径同一语义); Rust 侧 kb-dismiss 回调保留 (引擎清理)
        dismiss => {
            KeyboardCtx.collapsed = true;
            fs.focus();
            root.kb-dismiss();
        }
    }

    // ===== 自动熄屏心跳: 1s 一次, 在 UI 线程判断; 无屏幕控制/永不/已熄屏时不跑 =====
    Timer {
        interval: 1s;
        running: root.screen-control-available && root.sleep-timeout-index > 0 && !root.screen-off;
        triggered => { root.sleep-tick(); }
    }

    // ===== 熄屏遮罩: 最顶层, 拦截业务点击; 任意触摸唤醒屏幕 =====
    // 背光/DPMS 关闭后界面仍在运行, 此遮罩负责吞掉熄屏期间的误触
    if root.screen-off: Rectangle {
        z: 10;
        background: #000000;

        TouchArea {
            clicked => { root.screen-wake(); }
        }
    }
}
