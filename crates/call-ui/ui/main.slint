// 主窗口: 组装各页面/状态栏/覆盖层, 持有跨页面共享状态 (toast/page)
// 组件集: Slint 官方 Material (build.rs 构建时下载解压到 ../material-1.1.0/,
// 用相对路径 import 而非 @material 库语法 — 编辑器 LSP 无需任何配置)
// phase: 0=Idle 1=Outgoing 2=Incoming 3=InCall (与 app.rs Phase 一一对应)
// Idle 下再分子页面 page: 0=主页 1=拨号 2=设置 3=监控 (纯 UI 状态, 不进状态机)
import {
    MaterialWindow,
    MaterialText,
    MaterialTypography,
    MaterialPalette,
    FilledButton,
    TextButton,
    OutlineButton,
} from "../material-1.1.0/material.slint";
// Material 主题全局状态需要链接进二进制, 模板同款写法
export { MaterialWindowAdapter } from "../material-1.1.0/material.slint";
import { CallLogEntry, ContactEntry, CameraEntry, DiscoveredEntry, ProfileEntry, AppToast, ErrorBanner } from "components.slint";
import { StatusBar } from "status_bar.slint";
import { HomePage } from "home_page.slint";
import { DialPage } from "dial_page.slint";
import { SettingsPage } from "settings_page.slint";
import { MonitorPage } from "monitor_page.slint";
import { InCallPage } from "in_call_page.slint";

export component MainWindow inherits MaterialWindow {
    in property <int> phase: 0;
    in property <string> peer: "";
    in-out property <string> error-text: "";
    in property <image> video-frame;
    // 主页状态 (Rust 侧驱动)
    in property <bool> sip-registered: false;
    in property <string> account: "";
    // 时钟: 后端只发原始时间组件, 格式化与翻译全在下方 @tr —
    // 后端不感知语言, 新增语言只改 lang/*.po
    in property <int> clock-hour: -1;
    in property <int> clock-minute: 0;
    in property <int> date-month: 1;
    in property <int> date-day: 1;
    in property <int> weekday-index: 0; // 0=周一 .. 6=周日
    property <string> weekday-short:
        weekday-index == 0 ? @tr("周一") :
        weekday-index == 1 ? @tr("周二") :
        weekday-index == 2 ? @tr("周三") :
        weekday-index == 3 ? @tr("周四") :
        weekday-index == 4 ? @tr("周五") :
        weekday-index == 5 ? @tr("周六") :
        @tr("周日");
    property <string> weekday-long:
        weekday-index == 0 ? @tr("星期一") :
        weekday-index == 1 ? @tr("星期二") :
        weekday-index == 2 ? @tr("星期三") :
        weekday-index == 3 ? @tr("星期四") :
        weekday-index == 4 ? @tr("星期五") :
        weekday-index == 5 ? @tr("星期六") :
        @tr("星期日");
    property <string> clock-text: clock-hour < 0 ? "--:--" :
        (clock-hour < 10 ? "0" : "") + clock-hour + ":" +
        (clock-minute < 10 ? "0" : "") + clock-minute;
    // @tr 只支持顺序占位 {}, 翻译侧可用 {0}/{1}/... 重排 (en: 星期提前)
    property <string> date-text: @tr("{}月{}日 {}", date-month, date-day, weekday-long);
    property <string> status-time-text: @tr("{}  {} {}/{}", clock-text, weekday-short, date-month, date-day);
    in property <int> today-visitors: 0;
    in property <int> unread-messages: 0;
    in property <[CallLogEntry]> call-log: [];
    in property <[ContactEntry]> contacts: [];
    in property <[CameraEntry]> cameras: [];
    // 摄像头操作忙标志 (搜索中/拉 profile 中), 对话框里转菊花文案
    in property <bool> camera-busy: false;
    in property <[DiscoveredEntry]> discovered-devices: [];
    in property <[ProfileEntry]> camera-profiles: [];
    in property <int> monitor-selected-id: -1;
    in property <string> settings-text: "";
    callback dial(string);
    callback accept-call();
    callback reject-call();
    callback hangup();
    callback set-language(string); // "zh" | "en"
    // 通讯录 CRUD (SQLite 持久化在 Rust store.rs)
    callback add-contact(string, string);
    callback update-contact(int, string, string);
    callback delete-contact(int);
    // 摄像头管理 (设置页): 手动添加/删除/ONVIF 搜索/拉 profile/保存搜索到的设备
    callback add-camera(string, string, string, string); // name, uri, user, pass
    callback delete-camera(int);
    callback search-cameras();
    callback fetch-camera-profiles(string, string, string); // xaddr, user, pass
    callback save-discovered-camera(string, string, string, string, string); // xaddr, name, user, pass, token
    // 监控页: 选中查看 / 离开停止 (Rust 侧 MonitorController)
    callback monitor-select(int);
    callback monitor-leave();
    // 后端通知管线入口 (app.rs Notice): 前端按 kind 解析文案 (i18n),
    // level 决定呈现 (0 info / 1 warn → toast, 2 error → 顶部错误条),
    // detail 可选 (空串 = 无), 用于系统错误原文或后端指定提示
    callback notify(level: int, kind: int, detail: string);

    property <string> displayed-error <=> root.error-text;
    error-timer := Timer {
        interval: 2s;
        running: root.displayed-error != "";
        triggered => {
            root.displayed-error = "";
        }
    }

    // 通知文案: kind 与 app.rs NoticeKind 一一对应 (0=Raw 1=RegisterFailed
    // 2=CallFailed), 按 kind 出本地化文案; detail 可选, 原样附加不翻译
    function notice-msg(kind: int, detail: string) -> string {
        if (kind == 1) {
            return detail == "" ? @tr("注册失败") : @tr("注册失败") + ": " + detail;
        }
        if (kind == 2) {
            return detail == "" ? @tr("呼叫失败") : @tr("呼叫失败") + ": " + detail;
        }
        return detail;
    }
    notify(level, kind, detail) => {
        if (detail == "" && kind == 0) {
            return;
        }
        if (level == 2) {
            root.error-text = notice-msg(kind, detail);
        } else {
            root.show-toast(notice-msg(kind, detail));
        }
    }

    // 纯 UI 状态: 子页面与气泡提示, 不进 Rust 状态机
    property <int> page: 0;
    property <string> toast: "";
    // toast 队列: 当前有气泡在显示时新消息排队, 前一条消失后依次展示 (每条 3 秒)
    property <[string]> toast-queue: [];
    function show-toast(t: string) {
        if (root.toast == "") {
            root.toast = t;
        } else if (toast-queue.length < 5) {
            // 连点防爆: 积压超过 5 条直接丢弃
            toast-queue.push(t);
        }
    }
    toast-timer := Timer {
        interval: 1s;
        // running 跟随 toast 非空: 队列续杯时保持 true, 计时器连续触发 (每条各 3 秒)
        running: root.toast != "";
        triggered => {
            if (root.toast-queue.length > 0) {
                root.toast = root.toast-queue[0];
                root.toast-queue.remove(0);
            } else {
                root.toast = "";
            }
        }
    }

    title: "media_talk";
    preferred-width: 1024px;
    preferred-height: 600px;
    min-width: 1024px;
    min-height: 600px;

    // ===== 状态栏 (通话视频全屏时隐藏) =====
    if root.phase != 3: StatusBar {
        y: 0;
        width: 100%;
        z: 1;
        sip-registered: root.sip-registered;
        account: root.account;
        status-time-text: root.status-time-text;
        show-toast(t) => { root.show-toast(t); }
    }

    // ===== 主页 =====
    if root.phase == 0 && root.page == 0: HomePage {
        y: 30px;
        width: 100%;
        height: parent.height - 30px;
        sip-registered: root.sip-registered;
        clock-text: root.clock-text;
        date-text: root.date-text;
        unread-messages: root.unread-messages;
        today-visitors: root.today-visitors;
        call-log: root.call-log;
        show-toast(t) => { root.show-toast(t); }
        open-page(p) => { root.page = p; }
        redial(num) => { root.dial(num); }
    }

    // ===== 拨号页 =====
    if root.phase == 0 && root.page == 1: DialPage {
        y: 30px;
        width: 100%;
        height: parent.height - 30px;
        contacts: root.contacts;
        back => { root.page = 0; }
        dial(num) => { root.dial(num); }
        add-contact(name, num) => { root.add-contact(name, num); }
        update-contact(id, name, num) => { root.update-contact(id, name, num); }
        delete-contact(id) => { root.delete-contact(id); }
    }

    // ===== 设置页 =====
    if root.phase == 0 && root.page == 2: SettingsPage {
        y: 30px;
        width: 100%;
        height: parent.height - 30px;
        settings-text: root.settings-text;
        cameras: root.cameras;
        camera-busy: root.camera-busy;
        discovered-devices: root.discovered-devices;
        camera-profiles: root.camera-profiles;
        back => { root.page = 0; }
        set-language(lang) => { root.set-language(lang); }
        add-camera(n, u, user, p) => { root.add-camera(n, u, user, p); }
        delete-camera(id) => { root.delete-camera(id); }
        search-cameras => { root.search-cameras(); }
        fetch-camera-profiles(x, user, p) => { root.fetch-camera-profiles(x, user, p); }
        save-discovered-camera(x, n, user, p, t) => { root.save-discovered-camera(x, n, user, p, t); }
        show-toast(t) => { root.show-toast(t); }
    }

    // ===== 监控页 =====
    if root.phase == 0 && root.page == 3: MonitorPage {
        y: 30px;
        width: 100%;
        height: parent.height - 30px;
        cameras: root.cameras;
        video-frame: root.video-frame;
        selected-id: root.monitor-selected-id;
        back => {
            root.monitor-leave();
            root.page = 0;
        }
        select-camera(id) => { root.monitor-select(id); }
        show-toast(t) => { root.show-toast(t); }
    }

    // ===== 通话中 =====
    if root.phase == 3: InCallPage {
        width: 100%;
        height: 100%;
        video-frame: root.video-frame;
        hangup => { root.hangup(); }
        show-toast(t) => { root.show-toast(t); }
    }

    // ===== 呼出中 =====
    if root.phase == 1: VerticalLayout {
        alignment: center;
        spacing: 24px;
        MaterialText {
            text: @tr("呼叫 {} ...", root.peer);
            style: MaterialTypography.headline_medium;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;
            OutlineButton {
                text: @tr("取消");
                clicked => { root.hangup(); }
            }
        }
    }

    // ===== 来电 =====
    if root.phase == 2: VerticalLayout {
        alignment: center;
        spacing: 24px;
        MaterialText {
            text: @tr("来电: {}", root.peer);
            style: MaterialTypography.headline_medium;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 24px;
            FilledButton {
                text: @tr("接听");
                clicked => { root.accept-call(); }
            }

            OutlineButton {
                text: @tr("拒接");
                clicked => { root.reject-call(); }
            }
        }
    }

    // ===== 错误条: 5s 自动消失, 内部 Timer 消化 (ErrorBanner 组件) =====
    ErrorBanner {
        y: 0;
        width: 100%;
        z: 2;
        text: root.displayed-error;
    }

    // ===== toast 浮条 (最后声明, 绘制在最上层; 纯 Rectangle 不挡点击) =====
    AppToast {
        width: 100%;
        height: 100%;
        text: root.toast;
        shown: root.toast != "";
    }
}
