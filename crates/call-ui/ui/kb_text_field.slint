// 屏幕键盘输入框: Kit 主题字段壳 + 裸 TextInput, 经 kb-commit-* 属性拍振上屏.
// 上屏语义 (计划 v1): 提交文本追加到末尾; 退格删末字符 (不跟踪光标位置).
//
// 这是迁移期唯一保留的自定义输入控件: Slint Kit 的文本组件使用原生
// TextInput, 会弹出我们的屏幕键盘但收不到 KeyboardCtx.commit-seq, 所以
// 文本输入仍由本组件承接. 视觉使用 KitTheme 令牌, 不引入第二套风格.
//
// 退格: Slint 字符串没有 substring/char-at, 经 KeyboardCtx.trim-last 回调
// 交给 Rust 删除最后一个 Unicode 字符; 不再依赖字段内的文本历史栈
// (历史栈对带默认值的初始种子没有记录, 首次退格会清空整个输入框).
import {
    ControlSize,
    KitMetrics,
    KitTheme,
    KitThemeContext,
    TypographyRole,
} from "@kit";

// 屏幕键盘全局上下文: 根部 kb-* 属性经此 global 下发到任意层级的
// KbTextField 实例, 免去逐层透传 (main.slint 根部 changed 处理器镜像).
// collapsed 为收起闩: "收起/完成"键与点空白置位, 全失焦时复位 — 键盘显隐
// = slint 官方 TextInputInterface.text-input-focused && !collapsed (方案 D).
// 注: slint 元素体内不能绑定 global 属性 (双向/单向绑定仅限本元素属性),
// 故同步只能走 changed 处理器, global 内也不放回调 (无法在外部接实现)
export global KeyboardCtx {
    in-out property <bool> collapsed: false;
    // 抬升门控: 当前聚焦字段需要上移的像素数 (0 = 不抬).
    // 由设置页/弹窗按字段底部与键盘顶边的重叠量计算; 全失焦时复位.
    in-out property <length> lift-offset: 0px;
    // 主窗口几何 (窗口坐标): 键盘顶边 / 最大抬升量, 由 main.slint 写入.
    in-out property <length> keyboard-top: 0px;
    in-out property <length> lift-max: 0px;
    in-out property <int> commit-seq: 0;
    in-out property <string> commit-text: "";
    in-out property <bool> delete-field: false;
    // 由 Rust 侧实现: 删除字符串最后一个 Unicode 字符 (退格用)
    callback trim-last(string) -> string;
}

export component KbTextField inherits Rectangle {
    in-out property <string> text: "";
    in property <string> label: "";
    in property <string> supporting-text: "";
    in property <InputType> input-type;
    // 尾部图标 (如密码可见性眼睛), 仍按 image 传入, 外观由 Kit 字段壳承载
    in property <image> trailing-icon;
    callback trailing-icon-clicked();
    // 上屏拍振: seq 每次上屏 +1 (Rust 侧装配, 见 main.slint 根部属性表)
    in property <int> commit-seq: 0;
    in property <string> commit-text: "";
    in property <bool> delete-field: false;

    callback edited(string);
    callback accepted(string);
    // 聚焦/失焦通知 (仅父级滚动定位等 UI 副作用消费; Rust 提交门控走
    // slint 官方 text-input-focused 镜像, 不经此回调 — 方案 D 无字段身份)
    callback focus-changed(bool);

    property <KitTheme> theme: KitThemeContext.current;
    // 内部焦点镜像 (内层 TextInput 真实焦点). 方案 D: 键盘显隐由 slint 官方
    // TextInputInterface.text-input-focused 决定, 此回调只服务 UI 副作用
    property <bool> priv-focused: input.has-focus;

    // 聚焦/失焦原样冒泡 (守卫已随字段身份一并移除 — Rust 门控读官方
    // text-input-focused 镜像, 不存在乱序消费问题)
    changed priv-focused => {
        root.focus-changed(root.priv-focused);
    }

    changed commit-seq => {
        if !root.priv-focused {
            return;
        }
        if root.delete-field {
            root.text = KeyboardCtx.trim-last(root.text);
        } else if root.commit-text != "" {
            root.text = root.text + root.commit-text;
        }
        // 程序化改 text 后光标停在原处 (可见性 bug), 显式移到末尾 —
        // 上屏/退格语义本就操作串尾.
        root.set-cursor-to-end();
        root.edited(root.text);
    }

    function set-cursor-to-end() {
        input.set-selection-offsets(
            root.text.character-count * 4 + 4,
            root.text.character-count * 4 + 4
        );
    }

    height: layout.preferred-height;

    layout := VerticalLayout {
        spacing: KitMetrics.help-gap(root.theme);
        alignment: start;

        if root.label != "" : Text {
            text: root.label;
            color: root.theme.text-primary;
            font-family: root.theme.typography.family;
            font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
            font-weight: root.theme.typography.weight-medium;
            wrap: word-wrap;
        }

        field := Rectangle {
            height: root.theme.spacing.unit * 12;
            background: root.theme.surface;
            border-radius: root.theme.shape.radius-control;
            border-width: root.theme.shape.border-width;
            border-color: input.has-focus ? root.theme.accent : root.theme.border-subtle;

            HorizontalLayout {
                padding-left: root.theme.spacing.unit * 3;
                padding-right: root.theme.spacing.unit * 2;
                spacing: root.theme.spacing.unit;

                input := TextInput {
                    horizontal-stretch: 1;
                    height: 100%;
                    text <=> root.text;
                    input-type: root.input-type;
                    single-line: true;
                    font-family: root.theme.typography.family;
                    font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
                    color: root.theme.text-primary;
                    selection-background-color: root.theme.accent;
                    selection-foreground-color: root.theme.on-accent;
                    vertical-alignment: center;
                    edited => {
                        root.edited(root.text);
                    }
                    accepted => {
                        root.accepted(root.text);
                    }
                }

                if root.trailing-icon.width > 0 : TouchArea {
                    width: root.theme.spacing.unit * 10;
                    height: 100%;
                    clicked => { root.trailing-icon-clicked(); }

                    Image {
                        width: 20px;
                        height: 20px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: root.trailing-icon;
                        colorize: root.theme.text-secondary;
                    }
                }
            }
        }

        if root.supporting-text != "" : Text {
            text: root.supporting-text;
            color: root.theme.text-secondary;
            font-family: root.theme.typography.family;
            font-size: KitMetrics.font-size(root.theme, TypographyRole.caption);
            wrap: word-wrap;
        }
    }
}
