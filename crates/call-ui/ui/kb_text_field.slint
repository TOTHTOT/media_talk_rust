// 屏幕键盘输入框: 内含 material TextField, 经 kb-commit-* 属性拍振上屏.
// 上屏语义 (计划 v1): 提交文本追加到末尾; 退格删末字符 (不跟踪光标位置).
//
// 实现说明: slint 1.18 字符串无 substring/char-at (语言内建仅有
// character-count 等, 见 i-slint-compiler lookup.rs), 无法直接切尾字符;
// 因此退格用"变更快照栈"实现 —— changed text 记录每次变更前的值,
// 退格拍振弹栈恢复上一个快照, 效果等价于删末字符 (含中文等多字节字符,
// 快照是完整字符串, 与字符宽度无关).
import { TextField } from "../material-1.1.0/material.slint";

// 屏幕键盘全局上下文: 根部 kb-* 属性经此 global 下发到任意层级的
// KbTextField 实例, 免去逐层透传 (main.slint 根部 changed 处理器镜像).
// focused-id 为当前聚焦输入框的 field-id (-1 = 无聚焦, 键盘隐藏).
// 唯一写入策略: 获得所有权只有一条路 — KbTextField 最上层 TouchArea 的
// 点击 (显式用户动作, 不依赖焦点迁移事件); 失去所有权只有两条路 —
// "完成"键/点空白 (main.slint 直写 -1 并经隐藏 FocusScope 抢焦点) 与
// KbTextField 的失焦兜底 (守卫式, 仅清理真实失焦如物理键盘 Tab).
// 卡片/对话框处理器只消费 focus-changed (Rust 路由/滚动定位), 不写本状态.
// 注: slint 元素体内不能绑定 global 属性 (双向/单向绑定仅限本元素属性),
// 故同步只能走 changed 处理器, global 内也不放回调 (无法在外部接实现)
export global KeyboardCtx {
    in-out property <int> focused-id: -1;
    in-out property <int> commit-seq: 0;
    in-out property <string> commit-text: "";
    in-out property <bool> delete-field: false;
}

export component KbTextField inherits Rectangle {
    in-out property <string> text: "";
    in property <string> label: "";
    in property <string> supporting-text: "";
    in property <InputType> input-type;
    // 输入框标识: 聚焦时经 focus-changed 登记到键盘控制器 (Task 3 分配)
    in property <int> field-id: -1;
    // 上屏拍振: seq 每次上屏 +1 (Rust 侧装配, 见 main.slint 根部属性表)
    in property <int> commit-seq: 0;
    in property <string> commit-text: "";
    in property <bool> delete-field: false;

    callback edited(string);
    callback accepted(string);
    // 聚焦发 field-id, 全失焦发 -1 (Rust 侧 KeyboardController::set_focus)
    callback focus-changed(int);

    // 内部焦点镜像: 点击时经 fs.focus() 给予自家隐藏 FocusScope (兄弟节点,
    // 不承担布局), 仅用于失焦兜底清理; 所有权主路径不依赖它
    fs := FocusScope {
        width: 1px;
        height: 1px;
    }
    property <bool> priv-focused: fs.has-focus;
    // 退格快照栈: text 每次变更前的值; 以及栈底之前的当前值镜像
    property <[string]> text-history: [];
    property <string> text-shadow: "";
    // 退格恢复期间置位, 禁止 changed text 把恢复动作本身再记入历史
    property <bool> restoring: false;

    // 所有权主路径: 点击即宣告"键盘属于我" — 显式用户动作, 不依赖焦点
    // 迁移事件的触发顺序/可靠性 (changed 派生所有权曾三连踩坑: 跨框迁移
    // 的乱序写覆盖、完成/点空白后同框无跳变). TouchArea 在最上层, 内层
    // TextField 不再收指针 (本组件上屏语义本就是追加式, 不做光标定位);
    // 输入全靠屏幕键盘经 commit 拍振. 副作用 (Rust 路由 / 滚动定位) 全部
    // 挂在 focus-changed 上, 同事件派发, 无双写竞争.
    TouchArea {
        width: 100%;
        height: 100%;

        clicked => {
            if !root.priv-focused {
                fs.focus();
            }
            KeyboardCtx.focused-id = root.field-id;
            root.focus-changed(root.field-id);
        }
    }

    // 失焦兜底: 物理键盘 Tab 走焦等真实失焦场景, 自己仍是当前主人才清 —
    // 不承担主路径正确性, 仅防残留所有权卡住显隐
    changed priv-focused => {
        if !root.priv-focused && KeyboardCtx.focused-id == root.field-id {
            KeyboardCtx.focused-id = -1;
            root.focus-changed(-1);
        }
    }

    changed text => {
        if root.restoring {
            return;
        }
        // 起步/首次外部种子同步只建立镜像不入栈; 此时 text 必为 "", 弹栈
        // 兜底同样回到 "", 与不记录等价
        if root.text-shadow == "" && root.text-history.length == 0 {
            root.text-shadow = root.text;
            return;
        }
        root.text-history.push(root.text-shadow);
        root.text-shadow = root.text;
    }

    changed commit-seq => {
        if !root.priv-focused {
            return;
        }
        if root.delete-field {
            root.restoring = true;
            if root.text-history.length > 0 {
                root.text = root.text-history[root.text-history.length - 1];
                root.text-history.remove(root.text-history.length - 1);
            } else {
                root.text = "";
            }
            root.text-shadow = root.text;
            root.restoring = false;
        } else if root.commit-text != "" {
            root.text = root.text + root.commit-text;
        }
        root.edited(root.text);
    }

    field := TextField {
        width: 100%;
        label: root.label;
        supporting-text: root.supporting-text;
        input-type: root.input-type;
        text <=> root.text;
        edited(t) => {
            root.edited(t);
        }
        accepted(t) => {
            root.accepted(t);
        }
    }

    // 根高度跟随内容 (label + 输入行 + supporting-text), 宽度由布局给
    height: field.height;
}
