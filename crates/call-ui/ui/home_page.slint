// 主页: 组装左侧时钟卡片 + 右侧 4x2 应用网格 + 底部最近通话
// 子组件在 home/ 目录: ClockCard / AppGrid / RecentCalls
import { MaterialPalette } from "../material-1.1.0/material.slint";
import { CallLogEntry } from "components.slint";
import { ClockCard } from "home/clock_card.slint";
import { AppGrid } from "home/app_grid.slint";
import { RecentCalls } from "home/recent_calls.slint";

export component HomePage inherits Rectangle {
    background: MaterialPalette.background;
    in property <bool> sip-registered;
    in property <string> clock-text;
    in property <string> date-text;
    in property <int> unread-messages;
    in property <int> today-visitors;
    in property <[CallLogEntry]> call-log;
    in property <int> weather-icon: -1;
    in property <string> weather-temp: "";
    callback show-toast(string);
    callback open-page(int); // 1=拨号 2=设置
    callback redial(string); // 最近通话点击回拨

    HorizontalLayout {
        padding-left: 16px;
        padding-bottom: 16px;
        padding-right: 16px;
        spacing: 16px;
        // 左侧时钟卡片 (3:17 比例)
        ClockCard {
            horizontal-stretch: 3;
            sip-registered: root.sip-registered;
            clock-text: root.clock-text;
            date-text: root.date-text;
            unread-messages: root.unread-messages;
            today-visitors: root.today-visitors;
            weather-icon: root.weather-icon;
            weather-temp: root.weather-temp;
            page-width: root.width;
            show-toast(t) => { root.show-toast(t); }
        }

        // 右侧: 应用网格 + 最近通话
        VerticalLayout {
            horizontal-stretch: 17;
            spacing: 12px;
            AppGrid {
                vertical-stretch: 1;
                unread-messages: root.unread-messages;
                show-toast(t) => { root.show-toast(t); }
                open-page(p) => { root.open-page(p); }
            }

            // 固定高度 (头部 36 + 两条 ListTile 72x2), 有无记录都不挤压上网格
            RecentCalls {
                height: 180px;
                vertical-stretch: 0;
                call-log: root.call-log;
                redial(num) => { root.redial(num); }
            }
        }
    }
}
