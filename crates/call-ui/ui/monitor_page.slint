// 监控页: 可折叠侧边栏切换已保存摄像头, 右侧视频画面 (复用对讲的
// video-frame 通路). 录制/截图是占位 (toast 暂不支持), 见设计文档预留节
import {
    ButtonIntent,
    ControlWidth,
    KitIconButton,
    KitMetrics,
    KitPressable,
    KitScrollArea,
    KitTheme,
    KitThemeContext,
    KitThemes,
    TypographyRole,
} from "@kit";
import { LucideIcons } from "@kit-icons/all.slint";
import { CameraEntry } from "components.slint";

export component MonitorPage inherits Rectangle {
    property <KitTheme> theme: KitThemeContext.current;
    in property <[CameraEntry]> cameras: [];
    in property <image> video-frame;
    in property <int> selected-id: -1;
    callback back();
    callback select-camera(int);
    callback show-toast(string);

    property <bool> sidebar-open: true;
    // 测试用 mock 数据, 完成后删除
    property <[CameraEntry]> mock-cameras: [
        { id: 1, name: "门口机", uri: "rtsp://192.168.1.10/stream1" },
        { id: 2, name: "车库摄像头", uri: "rtsp://192.168.1.11/stream1" },
        { id: 3, name: "后花园", uri: "rtsp://192.168.1.12/stream1" },
    ];
    property <[CameraEntry]> display-cameras: root.cameras.length > 0 ? root.cameras : root.mock-cameras;

    // ===== 视频区 =====
    Rectangle {
        background: #000000;

        Image {
            width: 100%;
            height: 100%;
            source: root.video-frame;
            image-fit: contain;
        }

        // 点击视频区唤出侧边栏
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.sidebar-open = !root.sidebar-open; }
        }

        // 返回: 左上角; 显式尺寸, 否则 Rectangle 会铺满父级.
        // 不设 z, 让后声明的侧边栏 (z:1) 可以盖住它.
        KitIconButton {
            // 视频区用 Kit 深色主题的 quiet 图标, 白图标 + 透明底, 不抢画面.
            theme: KitThemes.dark;
            intent: ButtonIntent.quiet;
            glyph: LucideIcons.arrow-left();
            accessible-name: @tr("返回");
            x: 24px;
            y: 24px;
            width: 40px;
            height: 40px;
            activated => { root.back(); }
        }

        // 底部操作: 录制/截图, 收缩到内容尺寸后定位到右下角
        HorizontalLayout {
            width: self.preferred-width;
            height: self.preferred-height;
            x: parent.width - self.width - 24px;
            y: parent.height - self.height - 24px;
            spacing: root.theme.spacing.unit * 3;
            z: 2;

            KitIconButton {
                theme: KitThemes.dark;
                intent: ButtonIntent.quiet;
                glyph: LucideIcons.circle-dot();
                accessible-name: @tr("录制");
                activated => { root.show-toast(@tr("录制功能暂不支持")); }
            }

            KitIconButton {
                theme: KitThemes.dark;
                intent: ButtonIntent.quiet;
                glyph: LucideIcons.camera();
                accessible-name: @tr("截图");
                activated => { root.show-toast(@tr("截图功能暂不支持")); }
            }
        }
    }

    // ===== 侧边栏: 悬浮在视频上方 (Kit 主题) =====
    if root.sidebar-open: Rectangle {
        x: 0;
        y: 0;
        width: 260px;
        height: 100%;
        z: 1;
        background: root.theme.surface;

        VerticalLayout {
            padding: root.theme.spacing.unit * 3;
            spacing: root.theme.spacing.unit;

            Text {
                text: @tr("摄像头");
                color: root.theme.text-primary;
                font-family: root.theme.typography.family;
                font-size: KitMetrics.font-size(root.theme, TypographyRole.subtitle);
                font-weight: root.theme.typography.weight-semibold;
            }

            if root.display-cameras.length == 0: Text {
                text: @tr("暂无摄像头\n请到设置页添加");
                color: root.theme.text-secondary;
                font-family: root.theme.typography.family;
                font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
                wrap: word-wrap;
            }

            if root.display-cameras.length > 0: KitScrollArea {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: root.theme.spacing.unit;

                    for cam in root.display-cameras: Rectangle {
                        height: root.theme.spacing.unit * 10;
                        background: cam.id == root.selected-id ? root.theme.accent-subtle : transparent;
                        border-radius: root.theme.shape.radius-control;

                        KitPressable {
                            width: 100%;
                            height: 100%;
                            intent: ButtonIntent.quiet;
                            control-width: ControlWidth.fill;
                            accessible-name: cam.name;
                            activated => { root.select-camera(cam.id); }

                            Text {
                                text: cam.name;
                                color: root.theme.text-primary;
                                font-family: root.theme.typography.family;
                                font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}
