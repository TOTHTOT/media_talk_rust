// 通用小组件与共享类型 (Kit 主题 + 现有业务结构体)
// 图标: lucide (https://lucide.dev), 编译期内嵌, 白描边风格统一 colorize
import {
    AlertSeverity,
    KitAlert,
    KitBadge,
    KitMetrics,
    KitTheme,
    KitThemeContext,
    KitToast,
    ToastEntry,
    TypographyRole,
} from "@kit";

export struct CallLogEntry {
    outgoing: bool,    // true=呼出 false=呼入 (未接必为呼入)
    missed: bool,      // 未接来电
    connected: bool,   // 是否接通
    peer: string,
    time: string,      // 结束时刻 "10:12"
    duration-s: int,   // 接通秒数, connected 时有效
}

// 通讯录条目 (SQLite contacts 表, Rust store.rs 维护)
export struct ContactEntry {
    id: int,
    name: string,
    number: string,
}

// 已保存摄像头 (SQLite cameras 表, Rust store.rs 维护)
export struct CameraEntry {
    id: int,
    name: string,
    uri: string,
    // 流类型显示标签 ("H264"/"H265"/"JPEG"/"" 未知), 列表里区分同设备多流
    kind: string,
}

// ONVIF 搜索到的设备 (未保存; index 是 Rust 侧列表下标)
export struct DiscoveredEntry {
    index: int,
    label: string,   // "厂商 型号 (地址)" 或裸地址
    xaddr: string,
}

// 设备的媒体 profile (选择后保存)
export struct ProfileEntry {
    token: string,
    label: string,   // "H264 1920x1080" 等
}

// 状态行小圆点 (纵向居中)
export component Dot inherits Rectangle {
    in property <brush> tint;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: root.tint;
}

// 应用图标卡片: Kit 主题卡片表面 + 彩色圆角底 lucide 图标 + 名称 + 角标
// 尺寸由外层 GridLayout 格子拉伸决定, 内部元素按格子尺寸缩放
export component AppIcon inherits Rectangle {
    property <KitTheme> theme: KitThemeContext.current;
    callback clicked();
    in property <image> icon;
    in property <string> label;
    in property <brush> tint;
    in property <int> badge: 0;

    background: root.theme.surface;
    border-width: root.theme.shape.border-width;
    border-color: root.theme.border-subtle;
    border-radius: root.theme.shape.radius-container;
    clip: true;

    // 悬停/按压反馈 (压在图标盒和文字下面, 只染卡片底色)
    Rectangle {
        border-radius: root.theme.shape.radius-container;
        background: root.theme.text-primary;
        opacity: touch.pressed ? 0.12 : touch.has-hover ? 0.08 : 0;
        animate opacity { duration: root.theme.motion.fast; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // 图标盒随格子尺寸缩放, 上限 88px; 注意不能放进 Layout 里:
    // 盒子尺寸依赖卡片尺寸, 进 Layout 会造成绑定循环, 用绝对定位手动组居中
    property <length> box: min(min(88px, root.width * 0.5), root.height * 0.45);
    property <length> label-h: 28px;
    property <length> group-h: root.box + root.theme.spacing.unit * 2 + root.label-h;

    Rectangle {
        x: (parent.width - root.box) / 2;
        y: (parent.height - root.group-h) / 2;
        width: root.box;
        height: root.box;
        background: root.tint;
        border-radius: root.box * 0.28;

        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.box * 0.55;
            height: root.box * 0.55;
            source: root.icon;
            colorize: #ffffff;
        }
    }

    Text {
        y: (parent.height - root.group-h) / 2 + root.box + root.theme.spacing.unit * 2;
        width: 100%;
        height: root.label-h;
        text: root.label;
        color: root.theme.text-primary;
        font-family: root.theme.typography.family;
        font-size: KitMetrics.font-size(root.theme, TypographyRole.control);
        font-weight: root.theme.typography.weight-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.badge > 0: KitBadge {
        x: parent.width - self.width - root.theme.spacing.unit * 3;
        y: root.theme.spacing.unit * 3;
        text: root.badge + "";
    }
}

// 气泡提示: 底部居中浮条. 使用 KitToast 的主题表面和语义色, 外层仍用
// 纯 Rectangle 定位, 避免 PopupWindow 吃掉整窗事件.
export component AppToast inherits Rectangle {
    in property <string> text;
    in property <bool> shown;
    property <KitTheme> theme: KitThemeContext.current;
    property <ToastEntry> entry: {
        token: 0,
        title: root.text,
        message: "",
        action-label: "",
        severity: AlertSeverity.information,
        dismissible: false,
        dismiss-label: "",
    };

    // 本体: shown 时滑入到底部, 隐藏时停在窗口底缘外
    toast-holder := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.shown ? parent.height - self.height - root.theme.spacing.unit * 8 : parent.height + 8px;
        width: Math.clamp(toast.preferred-width, 100px, Math.min(344px, parent.width - 32px));
        height: toast.preferred-height;
        opacity: root.shown ? 1 : 0;
        animate y {
            duration: root.theme.reduced-motion ? 0ms : 250ms;
            easing: ease-out;
        }
        animate opacity { duration: root.theme.reduced-motion ? 0ms : 150ms; }

        toast := KitToast {
            width: 100%;
            entry: root.entry;
        }
    }
}

// 错误条: 顶部红色横条, text 非空即显示
// 自动消失由调用方在 main.slint 用 Timer 清 text, 这里只负责渲染
export component ErrorBanner inherits Rectangle {
    in property <string> text;

    if root.text != "": KitAlert {
        y: 0;
        width: 100%;
        severity: AlertSeverity.error;
        title: root.text;
    }
}
