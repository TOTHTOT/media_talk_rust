// 通用小组件与共享类型 (基于 Slint 官方 Material 组件集)
// 图标: lucide (https://lucide.dev), 编译期内嵌, 白描边风格统一 colorize
import {
    FilledCard,
    Badge,
    MaterialText,
    MaterialTypography,
    MaterialPalette,
} from "../material-1.1.0/material.slint";

export struct CallLogEntry {
    outgoing: bool,    // true=呼出 false=呼入 (未接必为呼入)
    missed: bool,      // 未接来电
    connected: bool,   // 是否接通
    peer: string,
    time: string,      // 结束时刻 "10:12"
    duration-s: int,   // 接通秒数, connected 时有效
}

// 通讯录条目 (SQLite contacts 表, Rust store.rs 维护)
export struct ContactEntry {
    id: int,
    name: string,
    number: string,
}

// 已保存摄像头 (SQLite cameras 表, Rust store.rs 维护)
export struct CameraEntry {
    id: int,
    name: string,
    uri: string,
}

// ONVIF 搜索到的设备 (未保存; index 是 Rust 侧列表下标)
export struct DiscoveredEntry {
    index: int,
    label: string,   // "厂商 型号 (地址)" 或裸地址
    xaddr: string,
}

// 设备的媒体 profile (选择后保存)
export struct ProfileEntry {
    token: string,
    label: string,   // "H264 1920x1080" 等
}

// 状态行小圆点 (纵向居中)
export component Dot inherits Rectangle {
    in property <brush> tint;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: root.tint;
}

// 应用图标卡片: Material 卡片 + 彩色圆角底 lucide 图标 + 名称 + 角标
// 尺寸由外层 GridLayout 格子拉伸决定, 内部元素按格子尺寸缩放
export component AppIcon inherits FilledCard {
    in property <image> icon;
    in property <string> label;
    in property <brush> tint;
    in property <int> badge: 0;

    // 不用 FilledCard 自带 clickable: 其 StateLayerArea 的 color 官方没接线 (透明),
    // 悬停/按压反馈不可见; 这里自绘反馈层 + 自己的 TouchArea
    clickable: false;

    // 悬停/按压反馈 (压在图标盒和文字下面, 只染卡片底色)
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        background: MaterialPalette.on_surface;
        opacity: touch.pressed ? 0.12 : touch.has-hover ? 0.08 : 0;
        animate opacity { duration: 120ms; }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // 图标盒随格子尺寸缩放, 上限 88px; 注意不能放进 Layout 里:
    // 盒子尺寸依赖卡片尺寸, 进 Layout 会造成绑定循环, 用绝对定位手动组居中
    property <length> box: min(min(88px, root.width * 0.5), root.height * 0.45);
    property <length> label-h: 28px;
    property <length> group-h: root.box + 10px + root.label-h;

    Rectangle {
        x: (parent.width - root.box) / 2;
        y: (parent.height - root.group-h) / 2;
        width: root.box;
        height: root.box;
        background: root.tint;
        border-radius: root.box * 0.28;
        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.box * 0.55;
            height: root.box * 0.55;
            source: root.icon;
            colorize: #ffffff;
        }
    }

    MaterialText {
        y: (parent.height - root.group-h) / 2 + root.box + 10px;
        width: 100%;
        height: root.label-h;
        text: root.label;
        style: MaterialTypography.title_medium;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.badge > 0: Badge {
        x: parent.width - self.width - 12px;
        y: 12px;
        text: root.badge;
    }
}

// 气泡提示: 底部居中浮条, 视觉复刻 Material SnackBar
// 不用官方 SnackBar (PopupWindow): 弹层需铺满窗口来定位, 会吃掉所有鼠标事件,
// toast 期间整窗不可点; 纯 Rectangle 无 TouchArea 事件穿透, 不挡界面
export component AppToast inherits Rectangle {
    in property <string> text;
    in property <bool> shown;

    // 本体: shown 时滑入到底部, 隐藏时停在窗口底缘外
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.shown ? parent.height - self.height - 30px : parent.height + 8px;

        // 自适应宽度
        width: Math.clamp(inner.preferred-width, 100px, Math.min(344px, parent.width - 32px));
        height: inner.preferred-height;
        background: MaterialPalette.inverse_surface;
        border-radius: 4px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000060;
        animate y {
            duration: 250ms;
            easing: ease-out;
        }

        inner := HorizontalLayout {
            padding-left: 26px;
            padding-right: 26px;
            padding-top: 12px;
            padding-bottom: 12px;
            MaterialText {
                horizontal-alignment: center;
                text: root.text;
                wrap: word-wrap;
                style: MaterialTypography.body_medium;
                color: MaterialPalette.inverse_on_surface;
                vertical-alignment: center;
            }
        }
    }
}

// 错误条: 顶部红色横条, text 非空即显示
// 自动消失由调用方在 main.slint 用 Timer 清 text, 这里只负责渲染
export component ErrorBanner inherits Rectangle {
    in property <string> text;

    if root.text != "" : Rectangle {
        y: 0;
        width: 100%;
        height: 32px;
        background: MaterialPalette.error;
        MaterialText {
            text: root.text;
            color: MaterialPalette.on_error;
            width: 100%;
            height: 100%;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
