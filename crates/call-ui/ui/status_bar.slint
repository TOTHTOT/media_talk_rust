// 顶部状态栏: 左 SIP / 中时间 / 右三个操作, 三段分开.
import {
    ControlSize,
    KitIcon,
    KitIconButton,
    KitMetrics,
    KitThemeContext,
    TypographyRole,
} from "@kit";
import { LucideIcons } from "@kit-icons/all.slint";

export component StatusBar inherits Rectangle {
    in property <bool> sip-registered;
    in property <string> account;
    in property <string> status-time-text;
    // true = 当前平台支持真实熄屏 (RK3566), false = 点击只弹 toast
    in property <bool> screen-control-available: false;
    callback show-toast(string);
    callback screen-power-pressed();

    background: KitThemeContext.current.surface;
    width: 100%;
    height: 7%;
    horizontal-stretch: 1;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: KitThemeContext.current.spacing.unit * 3;
        padding-right: KitThemeContext.current.spacing.unit * 3;
        spacing: KitThemeContext.current.spacing.unit * 2;
        // 主轴保持默认 stretch: 左/右按内容宽, 中间吃掉剩余空间;
        // 垂直居中用 cross-axis-alignment, 不是 alignment.
        cross-axis-alignment: center;

        // 左: SIP 图标 + 账号
        HorizontalLayout {
            cross-axis-alignment: center;
            spacing: KitThemeContext.current.spacing.unit;

            KitIcon {
                control-size: ControlSize.compact;
                glyph: root.sip-registered
                    ? LucideIcons.phone()
                    : LucideIcons.phone-off();
                ink: root.sip-registered
                    ? KitThemeContext.current.accent
                    : KitThemeContext.current.danger;
            }

            Text {
                text: root.account;
                color: KitThemeContext.current.text-secondary;
                font-family: KitThemeContext.current.typography.family;
                font-size: KitMetrics.font-size(KitThemeContext.current, TypographyRole.caption);
                vertical-alignment: center;
            }
        }

        // 中: 时间占满剩余空间, 居中
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            cross-axis-alignment: center;

            Text {
                text: root.status-time-text;
                color: KitThemeContext.current.text-primary;
                font-family: KitThemeContext.current.typography.family;
                font-size: KitMetrics.font-size(KitThemeContext.current, TypographyRole.subtitle);
                font-weight: KitThemeContext.current.typography.weight-semibold;
                horizontal-alignment: center;
            }
        }

        // 右: 布防 + wifi + 电源
        HorizontalLayout {
            cross-axis-alignment: center;
            spacing: KitThemeContext.current.spacing.unit / 2;

            KitIconButton {
                glyph: LucideIcons.shield-check();
                accessible-name: @tr("布防");
                activated => { root.show-toast(@tr("安防功能开发中")); }
            }

            KitIconButton {
                glyph: LucideIcons.wifi();
                accessible-name: @tr("网络");
                activated => { root.show-toast(@tr("网络状态")); }
            }

            KitIconButton {
                glyph: LucideIcons.power();
                accessible-name: @tr("关闭屏幕");
                activated => {
                    if (root.screen-control-available) {
                        root.screen-power-pressed();
                    } else {
                        root.show-toast(@tr("当前平台不支持关闭屏幕"));
                    }
                }
            }
        }
    }
}
