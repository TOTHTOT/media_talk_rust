// 顶部状态栏: 官方 SmallAppBar — title 放 SIP 状态 + 时间,
// 尾部图标按钮: 布防 (点击气泡提示) + wifi 装饰
import { SmallAppBar } from "../material-1.1.0/material.slint";

export component StatusBar inherits SmallAppBar {
    in property <bool> sip-registered;
    in property <string> account;
    in property <string> status-time-text;
    callback show-toast(string);

    show_background: true;
    title: (root.sip-registered ? @tr("SIP 已注册 · {}", root.account) : @tr("SIP 未注册"))
        + "  ·  " + root.status-time-text;
    trailing_buttons: [
        { icon: @image-url("icons/shield-check.svg"), tooltip: @tr("布防中") },
        { icon: @image-url("icons/wifi.svg"), tooltip: @tr("网络") },
    ];
    trailing_button_clicked(index) => {
        if (index == 0) {
            root.show-toast(@tr("安防功能开发中"));
        }
    }
}
