// 屏幕键盘: 底部滑出面板, 纯触屏 (QWERTY 字母区 zh/en 共用 + 数字符号页).
// 布局参考 iOS 中文键盘: 顶部工具栏 (候选/预编辑 + ▼ 收起), 字母键带
// 数字/符号小标 (长按 500ms 输入小标), 白色圆角键浅灰底, 底行
// 123/,/空格/。/中英/完成(蓝色高亮). 上屏走 main.slint 根部 kb-commit-*
// 属性拍振, 由聚焦的 KbTextField 消费.
import {
    MaterialText,
    MaterialTypography,
    ScrollView,
} from "../material-1.1.0/material.slint";

// 单个按键. 三态配色 (iOS 惯例): 默认白底字母键, gray 功能键 (浅灰),
// accent 高亮键 (完成, 蓝). 小标 sub-label 做数字/符号提示 (纯展示).
// enabled=false 时置灰且不响应 (如中文不可用时置灰中英键).
component KbKey inherits Rectangle {
    in property <string> label: "";
    in property <string> sub-label: "";
    in property <image> icon;
    in property <bool> gray: false;
    in property <bool> accent: false;
    in property <bool> enabled: true;
    // 长按连发 (退格用): 按下立即上屏一次, 500ms 后进入 90ms 连发, 松手停
    in property <bool> auto-repeat: false;

    callback tapped(string);

    // 长按已发小标, 松手时抑制 click (避免长按后松手又补一个字母)
    property <bool> sub-fired: false;
    property <bool> suppress-click: false;

    repeat-delay := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            repeat-timer.running = true;
            if touch.pressed && root.enabled {
                root.tapped(root.label);
            }
        }
    }

    repeat-timer := Timer {
        interval: 90ms;
        running: false;
        triggered => {
            if !touch.pressed {
                self.running = false;
            } else if root.enabled {
                root.tapped(root.label);
            }
        }
    }

    // 小标长按输入: 按住 300ms 发 sub-label (数字/符号), 快按仍是主键值.
    // 上滑输入已废弃 — 拖拽手势在 PC 鼠标与触屏间可靠性差, 长按更稳.
    sub-delay := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            self.running = false;
            if touch.pressed && root.enabled && root.sub-label != "" {
                root.sub-fired = true;
                root.tapped(root.sub-label);
            }
        }
    }

    height: 46px;
    horizontal-stretch: 1; // 默认等宽铺满整行, 实例可覆盖 (空格 4 键宽等)
    background: root.accent ? #0b7cf0 : root.gray ? #b7bcc6 : #ffffff;
    border-radius: 8px;
    clip: true;
    opacity: root.enabled ? 1 : 0.45;
    drop-shadow-color: #0000001f;
    drop-shadow-blur: 1px;
    drop-shadow-offset-y: 1px;

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if root.auto-repeat && root.enabled {
                    // 连发键按下即上屏一次 (不等 click), 并启动长按连发
                    root.tapped(root.label);
                    root.suppress-click = true;
                    repeat-delay.running = true;
                } else if root.sub-label != "" && root.enabled {
                    sub-delay.running = true;
                }
            } else if event.kind == PointerEventKind.up {
                repeat-delay.running = false;
                repeat-timer.running = false;
                sub-delay.running = false;
                if root.sub-fired {
                    root.sub-fired = false;
                    root.suppress-click = true; // 长按已发小标, 不再发主键值
                }
            }
        }

        clicked => {
            if root.suppress-click {
                root.suppress-click = false;
                return;
            }
            if root.enabled {
                root.tapped(root.label);
            }
        }
    }

    // 内容区整体垂直居中: 有/无小标都居中, 不再顶部 padding 堆叠
    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;

        if root.sub-label != "": MaterialText {
            height: 15px;
            text: root.sub-label;
            style: MaterialTypography.body_small;
            color: root.accent ? #ffffffb3 : #8a8f99;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.label != "": MaterialText {
            text: root.label;
            style: MaterialTypography.body_large;
            color: root.accent ? #ffffff : #1c1c1e;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.icon.width > 0 && root.icon.height > 0: Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        source: root.icon;
        colorize: root.gray ? #1c1c1e : #4a4f59;
    }

    states [
        pressed when touch.pressed: {
            background: root.accent ? #0a6bd4 : #d7d9de;
        }
    ]
}

export component Keyboard inherits Rectangle {
    // 属性表见实施计划 Task 2 (main.slint 根部同名属性透传)
    in property <int> kb-mode: 0; // 0=zh 1=en 2=num
    in property <bool> kb-zh-available: false;
    in property <string> kb-preedit: "";
    in property <[string]> kb-candidates: [];

    callback key-tapped(string);
    callback backspace();
    callback candidate(int);
    callback space();
    callback mode(int);
    callback dismiss();

    // 上挡三态 (iOS): 0=小写 1=下一次大写 2=大写锁定; 点按循环.
    // 字母上屏后: 态 1 自动回 0, 态 2 保持. 转换在键盘层做.
    property <int> shift-state: 0;

    background: #d2d5dbe0;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    clip: true;

    // 全尺寸吞点击层 (z 最低): 按键缝/候选间隔的点击若不拦截会穿透到
    // 键盘下方的页面按钮 (实测可复现). 按键自身的 TouchArea 在本层之上,
    // 不受影响; 此层无回调, 纯消费.
    TouchArea {
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 10px;
        spacing: 8px;

        // ===== 顶部工具栏 (常驻): 左候选区 (仅中文有内容时占位的预编辑/
        // 候选) + 右侧 ▼ 收起. 参考 iOS 键盘顶栏 =====
        HorizontalLayout {
            spacing: 8px;
            height: 40px;

            if root.kb-mode == 0 && (root.kb-preedit != "" || root.kb-candidates.length > 0): Rectangle {
                horizontal-stretch: 0;
                min-width: 72px;
                height: 40px;
                background: #ffffff;
                border-radius: 8px;

                // 预编辑拼音串: 点击退一步 (发 backspace)
                preedit-touch := TouchArea {
                    clicked => {
                        root.backspace();
                    }
                }

                MaterialText {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: root.kb-preedit;
                    style: MaterialTypography.body_large;
                    color: #0b7cf0;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // 候选词横向排布, 触摸滑动, 点击上屏 candidate(index)
            if root.kb-mode == 0 && root.kb-candidates.length > 0: ScrollView {
                horizontal-stretch: 1;
                min-width: 0px;
                min-height: 0px;
                vertical_scrollbar_policy: ScrollBarPolicy.always_off;
                horizontal_scrollbar_policy: ScrollBarPolicy.always_off;

                HorizontalLayout {
                    spacing: 8px;

                    for word[i] in root.kb-candidates: KbKey {
                        label: word;
                        height: 40px;
                        min-width: 64px;
                        horizontal-stretch: 0; // 候选键按内容定宽, 不拉伸
                        tapped => {
                            root.candidate(i);
                        }
                    }
                }
            }

            // 候选区缺席时占位, 把 ▼ 顶到最右
            if root.kb-mode != 0 || (root.kb-preedit == "" && root.kb-candidates.length == 0): Rectangle {
                horizontal-stretch: 1;
            }

            // ▼ 收起 (参考 iOS 顶栏右侧)
            KbKey {
                label: "▼";
                gray: true;
                horizontal-stretch: 0;
                min-width: 52px;
                tapped => {
                    root.dismiss();
                }
            }
        }

        // ===== 键盘主体: zh/en 共用 QWERTY 三行 (字母键带数字/符号小标,
        // 纯提示不上屏), num 切数字符号页 =====
        if root.kb-mode != 2: VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;

                for letter[i] in ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"]: KbKey {
                    sub-label: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"][i];
                    label: letter;
                    tapped(k) => {
                        // 必须用参数 k: 长按小标时 KbKey 发来的是 sub-label,
                        // 用循环变量 letter 会把小标值丢弃 (长按/上滑失效的根因)
                        root.key-tapped(root.shift-state != 0 ? k.to-uppercase() : k);
                        if root.shift-state == 1 {
                            root.shift-state = 0;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                for letter[i] in ["a", "s", "d", "f", "g", "h", "j", "k", "l"]: KbKey {
                    sub-label: ["~", "@", "#", "$", "%", "&", "*", "(", ")"][i];
                    label: letter;
                    tapped(k) => {
                        // 必须用参数 k: 长按小标时 KbKey 发来的是 sub-label,
                        // 用循环变量 letter 会把小标值丢弃 (长按/上滑失效的根因)
                        root.key-tapped(root.shift-state != 0 ? k.to-uppercase() : k);
                        if root.shift-state == 1 {
                            root.shift-state = 0;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                // 上挡键 (左端, 参考 iOS 三态): 小写=灰 / 下一次=白底 /
                // 锁定=蓝底, 点按循环 0→1→2→0
                KbKey {
                    label: "↑";
                    gray: root.shift-state == 0;
                    accent: root.shift-state == 2;
                    tapped => {
                        root.shift-state = Math.mod(root.shift-state + 1, 3);
                    }
                }

                for letter[i] in ["z", "x", "c", "v", "b", "n", "m"]: KbKey {
                    sub-label: ["'", "/", "-", "_", ":", ";", "`"][i];
                    label: letter;
                    tapped(k) => {
                        // 必须用参数 k: 长按小标时 KbKey 发来的是 sub-label,
                        // 用循环变量 letter 会把小标值丢弃 (长按/上滑失效的根因)
                        root.key-tapped(root.shift-state != 0 ? k.to-uppercase() : k);
                        if root.shift-state == 1 {
                            root.shift-state = 0;
                        }
                    }
                }

                // 退格 (右端, 参考 iOS 位置); 长按 500ms 后连续删除
                KbKey {
                    icon: @image-url("icons/delete.svg");
                    gray: true;
                    auto-repeat: true;
                    tapped => {
                        root.backspace();
                    }
                }
            }
        }

        if root.kb-mode == 2: VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;

                for digit in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]: KbKey {
                    label: digit;
                    tapped => {
                        root.key-tapped(digit);
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                for symbol in ["@", "#", "$", "%", "&", "*", "-", "+", "=", "("]: KbKey {
                    label: symbol;
                    tapped => {
                        root.key-tapped(symbol);
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                for symbol in [")", "[", "]", ":", ";", "/", ".", ",", "?", "!"]: KbKey {
                    label: symbol;
                    tapped => {
                        root.key-tapped(symbol);
                    }
                }
            }
        }

        // ===== 底行功能键: 参考 iOS — 123(数字页往返) / , / 空格 / 。 /
        // 中英 / 完成(蓝色高亮) =====
        HorizontalLayout {
            spacing: 8px;

            // 数字页往返: 字母态进 num, num 态回字母 (zh 可用回 zh)
            KbKey {
                label: root.kb-mode == 2 ? "ABC" : "123";
                gray: true;
                tapped => {
                    root.mode(root.kb-mode == 2 ? (root.kb-zh-available ? 0 : 1) : 2);
                }
            }

            // 标点随语言 (iOS 惯例): 中文态全角 ，。; 英文态半角 ,.
            // 长按出备选: ，→；, 。→？ (en: ,→; .→?)
            KbKey {
                label: root.kb-mode == 0 ? "，" : ",";
                sub-label: root.kb-mode == 0 ? "；" : ";";
                tapped(s) => {
                    root.key-tapped(s);
                }
            }

            KbKey {
                label: @tr("空格");
                horizontal-stretch: 4; // 空格占 4 键宽
                tapped => {
                    root.space();
                }
            }

            KbKey {
                label: root.kb-mode == 0 ? "。" : ".";
                sub-label: root.kb-mode == 0 ? "？" : "?";
                tapped(s) => {
                    root.key-tapped(s);
                }
            }

            // 中英切换: 各页常显; 中文引擎仅 Linux 可用, 其他平台置灰.
            // num 页点击直接回字母页 (进 zh, 不可用时进 en)
            KbKey {
                enabled: root.kb-zh-available;
                label: root.kb-mode == 1 ? "EN" : "中";
                gray: true;
                tapped => {
                    root.mode(root.kb-mode == 0 ? 1 : (root.kb-zh-available ? 0 : 1));
                }
            }

            // num 页补退格 (字母页退格在第三行; 长按连发同 letter 页)
            if root.kb-mode == 2: KbKey {
                icon: @image-url("icons/delete.svg");
                gray: true;
                auto-repeat: true;
                tapped => {
                    root.backspace();
                }
            }

            KbKey {
                label: @tr("完成");
                accent: true;
                horizontal-stretch: 1.4;
                tapped => {
                    root.dismiss();
                }
            }
        }
    }
}
