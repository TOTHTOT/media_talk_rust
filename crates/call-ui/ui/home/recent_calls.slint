import {
    KitCard,
    KitCardBody,
    KitCardHeader,
    KitMetrics,
    KitScrollArea,
    LayoutSpace,
    TypographyRole,
} from "@kit";
import { CallLogEntry } from "../components.slint";
import { RecentCallRow } from "recent_call_row.slint";

export component RecentCalls inherits KitCard {
    in property <[CallLogEntry]> call-log;
    callback redial(string);

    inset: LayoutSpace.compact;
    gap: LayoutSpace.tight;
    clip: true;

    KitCardHeader {
        padding: 5px;
        title: @tr("最近通话");
    }

    KitCardBody {
        if root.call-log.length == 0: Text {
            width: 100%;
            text: @tr("暂无通话记录");
            color: root.theme.text-secondary;
            font-family: root.theme.typography.family;
            font-size: KitMetrics.font-size(root.theme, TypographyRole.body);
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.call-log.length > 0: KitScrollArea {
            // 滚动条改为浮层: 默认布局会给右侧滚动条留一条 gutter,
            // hover 背景只铺到 gutter 前, 看起来像没盖满整行.
            overlay-scrollbars: true;
            // 吃掉卡片剩余高度; 原来固定 108px, 180px 卡片装不下三条两行记录.
            height: root.height - root.theme.spacing.unit * 14;

            VerticalLayout {
                spacing: root.theme.spacing.unit;

                for entry[i] in root.call-log: RecentCallRow {
                    entry: entry;
                    redial(num) => { root.redial(num); }
                }
            }
        }
    }
}
